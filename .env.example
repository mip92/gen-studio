
DATABASE_URL="postgresql://gen_studio:gen_studio@localhost:5432/gen_studio?schema=public"
COMFY_BASE_URL=http://127.0.0.1:8188
PORT=3000

# Telegram bot — separate process started via `npm run bot`.
# Token from @BotFather. ALLOWED_USER_ID is your numeric Telegram user ID
# (get it from @userinfobot). The bot will silently ignore anyone else.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
