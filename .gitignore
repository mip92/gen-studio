node_modules
# Keep environment variables out of version control
.env

/generated/prisma

# Build output
dist

# Local data — exclude heavy subdirs (datasets, generated shots, reference assets)
# but keep ComfyUI workflow templates which are tiny JSON and shared across the team.
data/*/character_pipeline/
data/*/characters/
data/*/datasets/
data/*/reference/
data/*/shots/
# Phase 2 library-character layout — same heavy artifacts under a different
# folder shape (data/_characters/<charCode>/<profileCode>/{reference,datasets}/).
data/_characters/*/*/reference/
data/_characters/*/*/datasets/
# Generated TTS narration audio (large wavs, regenerated on demand).
data/*/scenes/
# Generated ACE-Step BGM audio (flacs ~5–30 MB each, regenerated on demand).
data/*/bgm/
# CapCut draft outputs (manifest.json + draft_content.json + copies).
data/*/exports/
# Final rendered videos (.mp4, often >100MB — over GitHub per-file limit).
data/*/finish/

# Python bytecode cache
__pycache__/
*.pyc

# Manual backups of comfy templates
data/*/comfy/*.bak

# Locally-downloaded Silero TTS model checkpoint (~140MB, user drops manually
# per scripts/tts_silero.py instructions; way over GitHub's per-file limit).
.silero_cache/

# heavy local artifacts (added during cleanup 2026-05-30)
/checkpoints/
/bin/
/.coqui_tts_cache/
/.hf_cache/
/.torch_cache/
data/*/tts/

# Final montage exports (multi-GB mp4s) + «понь» trim backups (wav) + shared voice refs
data/*/final/
data/*/_pon_backup/
data/_voices/

# stray local artifacts
.next/
backend_stdout.log
backend_stderr.log

# Qwen3-TTS local venv (py3.12/cu128, multi-GB — never commit)
.venv-qwen3/
# CapCut draft backups (transient, large)
_capcut_draft_backups_*/
# YouTube OAuth tokens/credentials — SECRETS, never commit
data/youtube-auth.json
# Thumbnail workshop artifacts (cover.png + candidates/, tens of MB per project)
data/*/thumbnail/
# stray dev logs
backend.log
serve_backend.log
# audit / migration scratch output (scripts/audit_motion_prompts.sql, _migrate_motion_wan22.py)
tmp_motion_*.txt
tmp_motion_*.out
