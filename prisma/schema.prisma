generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Project ─────────────────────────────────────────────────────────────────

model Project {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  settings  Json?
  /// Full narration script for the project (Markdown). Source of truth lives
  /// in the database so the API can serve it without depending on filesystem
  /// state. Scenes hold their own snippet of this in Scene.narrationText.
  scriptText String?
  /// Distribution target: "youtube" | "tiktok" | "shorts" | "longform".
  /// Drives platform-specific safety/length checks at shotlist time.
  targetPlatform String?
  /// Safety tier for advertiser-friendliness checks. "advertiser_safe" =
  /// strict YouTube monetization guardrails (no self-harm, no graphic violence,
  /// no brands, etc.); "limited" = age-gate acceptable; "unrestricted" = no
  /// filtering. Default null = unrestricted. Applied by shotlist generator
  /// and prompt sanitizer.
  safetyTier String?
  /// Canonical negative prompt for every shot in this project. SDXL accepts it
  /// verbatim. Single source of truth — `Shot.promptFields.negative` is treated
  /// as a per-shot override; if absent or empty the renderer reads this value.
  /// Lets editing happen in one place instead of touching all shots.
  ///
  /// **Required** (NOT NULL + CHECK non-empty) — every project must define its
  /// own. See AGENTS.md §1, §6.
  defaultNegative String
  /// Canonical negative prompt for the i2v / video model (Wan2.2 etc.). Same
  /// fallback chain as `defaultNegative` but for video render workflows.
  /// Per-shot override lives in `Shot.promptFields.motionNegative`.
  /// **Required** (NOT NULL + CHECK non-empty).
  defaultVideoNegative String
  /// Default motion-prompt text used when a video render has no explicit
  /// motion prompt and the shot is NOT marked static. Per-shot override:
  /// `Shot.promptFields.motionPrompt`.
  /// **Required** (NOT NULL + CHECK non-empty).
  defaultMotionPrompt String
  /// Default motion-prompt text used when a video render has no explicit
  /// motion prompt AND `Shot.promptFields.camera.movement` starts with
  /// "static". Should be a strong "freeze frame, no motion" directive.
  /// **Required** (NOT NULL + CHECK non-empty).
  defaultStaticMotionPrompt String
  /// TTS engine to use for narration synthesis. 'silero' = CPU Silero V5 ru
  /// (default; legacy projects); 'xtts2' = XTTS-v2 GPU voice cloning;
  /// 'f5' = F5-TTS Russian GPU voice cloning. Null = treat as 'silero'.
  /// Endpoints branch on this field.
  ttsEngine               String?
  /// Project-relative path to the single voice reference wav used by the
  /// voice-clone engines (xtts2 / f5). Convention:
  /// data/<slug>/tts/voice_reference.wav. Null = not uploaded yet (renders
  /// fail with a clear error until set when ttsEngine is a voice-clone engine).
  ttsVoiceRefPath         String?
  /// Visual style of this project. Drives workflow routing + LoRA pipeline +
  /// style-block injection into shot prompts. References visual_styles.id.
  /// Default photoreal_cinematic for backwards compatibility with last_shift /
  /// night_courier. See docs/VISUAL_STYLE_ARCHITECTURE.md.
  visualStyle             String       @default("photoreal_cinematic")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  characters        Character[]
  characterLinks    ProjectCharacter[]
  scenes            Scene[]
  shots             Shot[]
  locations         Location[]
  workflowTemplates WorkflowTemplate[]
  workflowRoutes    WorkflowRoute[]
  referenceAssets   ReferenceAsset[]
  narrativeBlocks   NarrativeBlock[]
  ttsEmotionRefs    ProjectTTSEmotionRef[]

  @@map("projects")
}

// ─── Characters ──────────────────────────────────────────────────────────────

model Character {
  id          String   @id @default(uuid())
  /// Legacy "creator project" reference. Null = library character (no creator project).
  /// Project participation is the source of truth via the `project_characters` join (see ProjectCharacter).
  /// Phase 2 will drop this column once existing characters are migrated to the library FS layout
  /// (`data/_characters/<code>/<profileCode>/...`) and all legacy `data/<slug>/datasets/<code>/`
  /// paths are repointed.
  projectId   String?
  code        String
  displayName String?
  createdAt   DateTime @default(now())

  /// Legacy back-reference to the "creator project". onDelete: SetNull so that
  /// deleting a project leaves library characters orphaned rather than cascade-deleted.
  /// Real project membership lives in `project_characters`.
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  profiles         CharacterProfile[]
  shotParticipants ShotParticipant[]
  /// M:N to projects. A character can be attached to any number of projects.
  projectLinks     ProjectCharacter[]
  referenceAssets  ReferenceAsset[]

  @@unique([projectId, code])
  @@map("characters")
}

/// Many-to-many join: which projects a character is attached to. A character
/// can live in the library (no rows here) or be attached to one or more
/// projects. Replacing the old "Character.projectId" hard-binding so projects
/// can share LoRAs / datasets.
model ProjectCharacter {
  projectId   String
  characterId String
  attachedAt  DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([projectId, characterId])
  @@index([characterId])
  @@map("project_characters")
}

model CharacterProfile {
  id             String   @id @default(uuid())
  characterId    String
  profileCode    String
  ageLabel       String?
  targetImages   Int?
  promptBase     String
  negative       String?
  promptAngles   String?
  promptVariety  String?
  datasetPath    String?
  /// "Active" LoRA — the one used by default for scene rendering. Defaults to
  /// the final epoch from the most recent successful training; user can switch
  /// to any entry in `loraVariants` via the UI to test intermediate checkpoints.
  loraPath       String?
  /// All trained LoRA files for this profile (final + epoch checkpoints from
  /// every successful training run). Each entry is { filename, fullPath, epoch?, sizeBytes, mtime, label }.
  /// Latest training overwrites this list to reflect current disk state.
  loraVariants   Json?
  triggerToken   String?
  /// If true, this profile is rendered without LoRA and identity is locked
  /// via IP-Adapter FaceID (or PuLID) using a single reference portrait.
  /// Used for "passenger"-style minor characters where training a LoRA per
  /// person is uneconomical. The reference image lives in ReferenceAsset
  /// for this profileCode (sortOrder = 0 is the FaceID anchor).
  useIpAdapter   Boolean  @default(false)
  createdAt      DateTime @default(now())

  character        Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  datasetJobs      DatasetJob[]
  trainingJobs     TrainingJob[]
  shotParticipants ShotParticipant[]
  anchorRenderJobs AnchorRenderJob[]

  @@unique([characterId, profileCode])
  @@map("character_profiles")
}

// ─── Reference Assets ────────────────────────────────────────────────────────

model ReferenceAsset {
  id          String   @id @default(uuid())
  /// Legacy project scope. Null = library asset (owned by character). Kept nullable for Phase 1 backwards compat;
  /// Phase 2 will drop this and `profileCode` once all rows have `characterId` populated.
  projectId   String?
  /// Legacy soft-deprecated profile code key. Use `characterId` as the canonical owner going forward.
  profileCode String
  /// Canonical owner of the reference asset. Backfilled from (projectId, profileCode → profile → character).
  /// Library assets must have this set.
  characterId String?
  path        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([projectId, profileCode])
  @@index([characterId])
  @@map("reference_assets")
}

// ─── Scenes ──────────────────────────────────────────────────────────────────

model Scene {
  id                          String   @id @default(uuid())
  projectId                   String
  sceneKey                    String
  title                       String?
  sortOrder                   Int      @default(0)
  defaultReferenceProfileCode String?
  /// Closed-caption / voiceover text for the scene. Plain Russian narrator
  /// script — Silero V5 ru synthesises this to data/<slug>/scenes/<sceneKey>/narration.wav.
  /// Edits don't retroactively change rendered TTSJob outputs — each job
  /// snapshots `text` at enqueue time.
  narrationText               String?
  /// User-approved TTS job for this scene — the "this is the one we ship"
  /// pick from the rendered history. Null = nothing approved yet. Stored as
  /// a plain id (no FK) so deleting a TTSJob row doesn't cascade-null the
  /// scene state; the UI just shows no approval if the id stops resolving.
  approvedTTSJobId            String?
  /// Reference to the project narration script: which lines in
  /// <slug>_script.md this scene covers (inclusive). Lets the UI link back
  /// "scene → source paragraphs" without duplicating ranges in code.
  scriptStartLine             Int?
  scriptEndLine               Int?
  /// Dramaturgical role of this scene in the 5-act / Freytag structure.
  /// Free-form per project — typical values: "setup" | "rising" | "midpoint"
  /// | "climax" | "resolution". Used by shotlist tools to enforce beat
  /// distribution across the project.
  actBeat                     String?
  /// Default palette key for shots in this scene. Project-specific token
  /// (e.g. "S01_sodium", "S04_dark_emerald"). Individual shots can override
  /// via Shot.paletteKey; this is the inherited default for atmosphere
  /// consistency across the scene.
  defaultPaletteKey           String?
  /// Default time-of-day for shots in this scene. Project-specific token
  /// (e.g. "sunset_day1", "night_day2", "dawn_day2"). Shot.timeOfDay
  /// overrides this when set.
  defaultTimeOfDay            String?
  /// Single canonical lighting-tokens string for every shot in this scene
  /// (e.g. "warm tungsten corridor lamps, deep indigo night windows, soft
  /// falloff, sleep silence"). Source of truth for atmosphere lighting —
  /// `Shot.promptFields.lightingMood` is a per-shot override that the renderer
  /// reads first and falls back to this scene-level value when absent.
  lightingMood                String?
  createdAt                   DateTime @default(now())

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots     Shot[]
  ttsJobs   TTSJob[]

  @@unique([projectId, sceneKey])
  @@map("scenes")
}

// ─── Shots ───────────────────────────────────────────────────────────────────

model Shot {
  id                 String   @id @default(uuid())
  projectId          String
  sceneId            String
  shotCode           String
  promptFields       Json?
  workflowRouteKey   String?
  referenceProfileId String?
  referenceImagePool Json?
  /// Accumulated rendered candidates for this shot.
  /// Shape: [{filename, promptId, seed, strategyId, createdAt}]
  renderedImages     Json?
  /// Filename of the candidate chosen as the canonical render for this shot.
  chosenRender       String?
  /// VideoRender.id chosen as the final/approved animation for this shot.
  /// Mirrors `chosenRender` for videos: once set, the scenes UI offers an upscale
  /// instead of another render, and downstream packaging treats this as the
  /// canonical motion clip. No FK so the row stays self-consistent if the video
  /// is hard-deleted; the setChosenVideo service validates membership.
  chosenVideoId      String?
  /// Latest in-flight ComfyUI prompt_id for this shot (cleared once result is recorded).
  activeRenderPromptId String?
  /// Per-shot narration text (Russian, ~5s of voiceover per shot). When set,
  /// the shot gets its own TTSJob → wav, and CapCut export lays each wav at
  /// the shot's video timeline position. Independent of Scene.narrationText
  /// (which is the legacy whole-scene voiceover and is kept for backward
  /// compatibility with other projects that still use scene-level narration).
  narrationText      String?
  /// User-approved TTSJob for this shot. Plain id (no FK) so deleting the
  /// TTSJob row doesn't cascade-null the shot state — UI just shows nothing
  /// approved if the id stops resolving. Mirrors Scene.approvedTTSJobId.
  approvedTTSJobId   String?
  /// Camera framing for this shot. Canonical values: "EWS" | "WS" | "MS" |
  /// "MCU" | "CU" | "ECU" | "OTS" | "BACK" | "POV". First-class column
  /// (not promptFields jsonb) so quota-checking and shot-variety enforcement
  /// can SQL-query distribution without parsing JSON. See [[feedback_shot_variety]].
  shotType           String?
  /// Camera angle. Canonical values: "eye" | "low" | "high" | "dutch".
  cameraAngle        String?
  /// Camera movement. Canonical values: "static" | "track_lateral" |
  /// "push_in" | "pull_out" | "window_pov" | "locked_off" | "handheld".
  cameraMove         String?
  /// Dramaturgical beat this shot serves. Project-specific token, e.g.
  /// "opening_image", "catalyst", "midpoint_twist", "all_is_lost",
  /// "break_into_three", "final_image". Lets the shotlist tool verify every
  /// shot earns its place in the plot.
  storyBeat          String?
  /// What this shot is doing narratively: "plot" | "character" | "atmosphere"
  /// | "transition" | "iconic". Helps balance the act so atmosphere-only
  /// shots don't crowd out plot-advancing ones.
  narrativeFunction  String?
  /// Which character/passenger vignette this shot belongs to. Free-form
  /// slug per project (e.g. "military", "mother_baby", "child_girl",
  /// "conductor"). Lets the shotlist verify each vignette gets its quota
  /// of shots and that beats are spread inside the vignette.
  vignetteSlug       String?
  /// True if this shot has no main characters (pure exterior, object macro,
  /// landscape). Used to enforce the ~15% B-roll quota that night_courier
  /// lacked. Mutually compatible with isIconic.
  isBroll            Boolean  @default(false)
  /// True if this shot is intentionally designed to be screenshot-worthy —
  /// composition, lighting and prop arrangement curated for thumbnail /
  /// preview use. Project should target ~1 iconic frame per 20-25 shots.
  isIconic           Boolean  @default(false)
  /// Override of Scene.defaultTimeOfDay. Project-specific token. Null =
  /// inherit from scene.
  timeOfDay          String?
  /// Override of Scene.defaultPaletteKey. Project-specific token. Null =
  /// inherit from scene.
  paletteKey         String?
  /// FK to the Location row whose `description` gets prepended into the
  /// shot's positive prompt at render time. Null = no location injection
  /// (use raw promptFields.positive verbatim). Set per-shot so a single
  /// canonical "interior of cramped Soviet train kupe" description can be
  /// reused by 90% of shots without duplicating prose in every promptFields.
  locationId         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene        Scene             @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  location     Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  participants ShotParticipant[]
  renderJobs   SceneRenderJob[]
  videoRenders VideoRender[]
  ttsJobs      TTSJob[]

  @@unique([projectId, shotCode])
  @@index([projectId, sceneId])
  @@index([projectId, shotType])
  @@index([projectId, vignetteSlug])
  @@index([projectId, isBroll])
  @@index([projectId, isIconic])
  @@index([locationId])
  @@map("shots")
}

/// Reusable location description per project. One row per setting
/// (train kupe, train corridor, train vestibule, station platform, snow
/// field, etc.). The `description` is rich prose that gets prepended into
/// the rendered positive prompt for any shot tagged with this location.
/// Edit once → every shot using this location updates.
model Location {
  id          String   @id @default(uuid())
  projectId   String
  slug        String
  name        String
  /// SDXL-ready prose, e.g. "interior of cramped narrow old Soviet
  /// long-distance passenger train kupe compartment, very tight space, two
  /// narrow lower berths and two narrow upper berths only (NO double beds),
  /// painted wood-and-frosted-glass door, single small window with curtain,
  /// indigo night outside, warm tungsten reading lamp, NOT outside, NOT at
  /// a platform, NOT in an apartment". Prepended to shot positive prompts.
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots   Shot[]

  @@unique([projectId, slug])
  @@map("locations")
}

model ShotParticipant {
  id          String  @id @default(uuid())
  shotId      String
  characterId String?
  /// Which character profile (LoRA + age variant) to use for this participant
  /// in this specific shot. Null = renderer falls back to the first profile
  /// of the character that has a trained LoRA.
  profileId   String?
  label       String

  shot      Shot              @relation(fields: [shotId], references: [id], onDelete: Cascade)
  character Character?        @relation(fields: [characterId], references: [id], onDelete: SetNull)
  profile   CharacterProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@map("shot_participants")
}

// ─── Workflow ─────────────────────────────────────────────────────────────────

model WorkflowTemplate {
  id          String   @id @default(uuid())
  projectId   String
  templateKey String
  filePath    String
  description String?
  /// Optional: this template is style-specific (e.g. graphic-novel cell-shaded
  /// IP-Adapter workflow). Null = generic across styles (TTS, BGM, upscale).
  /// References visual_styles.id.
  visualStyle String?
  createdAt   DateTime @default(now())

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  routeSteps WorkflowRouteStep[]

  @@unique([projectId, templateKey])
  @@map("workflow_templates")
}

model WorkflowRoute {
  id        String   @id @default(uuid())
  projectId String
  routeKey  String
  createdAt DateTime @default(now())

  project Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps   WorkflowRouteStep[]

  @@unique([projectId, routeKey])
  @@map("workflow_routes")
}

model WorkflowRouteStep {
  id                 String @id @default(uuid())
  workflowRouteId    String
  stepOrder          Int
  workflowTemplateId String

  workflowRoute    WorkflowRoute    @relation(fields: [workflowRouteId], references: [id], onDelete: Cascade)
  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Restrict)

  @@unique([workflowRouteId, stepOrder])
  @@map("workflow_route_steps")
}

// ─── Training ─────────────────────────────────────────────────────────────────

model DatasetJob {
  id                  String    @id @default(uuid())
  profileId           String
  status              String    // pending | blocked | running | completed | failed | cancelled
  /// If set, this job waits until the named profile's dataset has at least one image.
  dependsOnProfileId  String?
  /// If set, the reference image used by ComfyUI is picked from this profile's
  /// dataset folder (chaining: HERO_TEEN_15 → HERO_OVERLOAD_16/17).
  referenceProfileId  String?
  /// Specific filename inside referenceProfileId's COMFY_OUTPUT to use as the
  /// reference. If not set, a deterministic middle image is auto-picked.
  referenceImageFilename String?
  comfyPromptId       String?
  errorMessage        String?
  queuedAt            DateTime  @default(now())
  startedAt           DateTime?
  completedAt         DateTime?

  profile CharacterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@index([status])
  @@map("dataset_jobs")
}

model SceneRenderJob {
  id            String    @id @default(uuid())
  shotId        String
  status        String    // pending | running | completed | failed | cancelled
  /// ComfyUI prompt_id once dispatched; used to poll history for outputs.
  comfyPromptId String?
  /// Render parameters at enqueue time (seed, batchSize, scenePrompt override, …).
  /// Stored so the queue worker can rebuild the call after a backend restart.
  params        Json?
  errorMessage  String?
  queuedAt      DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  shot Shot @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@index([shotId])
  @@index([status, queuedAt])
  @@map("scene_render_jobs")
}

// ─── Video renders ───────────────────────────────────────────────────────────
//
// Image-to-video renders driven by Wan2.2 i2v. One row per submitted job; the
// row holds the source image (the shot's approved render), the motion prompt,
// and the resulting mp4 filename once ComfyUI finishes.

model VideoRender {
  id                  String    @id @default(uuid())
  shotId              String
  /// Which image was used as the i2v starting frame. Stored as the basename
  /// inside `data/<project>/shots/<shotCode>/`.
  sourceImageFilename String
  /// Motion prompt — what should the animated frame do (camera move, subject
  /// movement, etc.). Concatenated into the Wan2.2 positive prompt.
  motionPrompt        String
  /// Lifecycle: pending → running → completed | failed | cancelled.
  status              String
  /// ComfyUI prompt_id once dispatched; used to poll history.
  comfyPromptId       String?
  /// Render parameters at enqueue time (seed, length, fps, width, height, etc.)
  params              Json?
  /// Basename of the output mp4 in `data/<project>/shots/<shotCode>/videos/`.
  outputFilename      String?
  /// Workflow filename used (e.g. "video_wan22_i2v_api.json").
  workflowFilename    String
  errorMessage        String?
  queuedAt            DateTime  @default(now())
  startedAt           DateTime?
  completedAt         DateTime?

  /// Upscale-on-demand (4x-UltraSharp → 1920×1080). Null until user clicks
  /// "upscale" on a completed video. Lifecycle mirrors the main status field.
  upscaleStatus        String?
  upscaledFilename     String?
  upscalePromptId      String?
  /// When this row's upscale lifecycle entered `pending`. Distinct from the
  /// main render's `queuedAt` because an upscale is requested some time after
  /// the underlying video finishes — sorting upscales by `queuedAt` would
  /// place every new upscale ahead of newly-queued renders.
  upscaleQueuedAt      DateTime?
  upscaleStartedAt     DateTime?
  upscaleCompletedAt   DateTime?
  upscaleErrorMessage  String?

  shot Shot @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@index([shotId])
  @@index([status, queuedAt])
  @@index([upscaleStatus, upscaleQueuedAt])
  @@map("video_renders")
}

model TrainingJob {
  id             String    @id @default(uuid())
  profileId      String
  status         String    // pending | preparing | captioning | training | completed | failed
  baseModel      String
  triggerToken   String?
  datasetPath    String?
  configPath     String?
  outputLoraPath String?
  logPath        String?
  errorMessage   String?
  progress       Json?     // { phase, current, total, ... }
  /// Effective queue ordering timestamp. Mirrors DatasetJob.queuedAt so the
  /// pipeline queue can order both job types by one field. Defaults to now()
  /// at row creation; gets swapped when the user reorders the queue in UI.
  queuedAt       DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile CharacterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@index([status, queuedAt])
  @@map("training_jobs")
}

// ─── TTS (Silero V5 ru) ──────────────────────────────────────────────────────
//
// One row per "synthesise this scene's narration" request. Runs on CPU via a
// Python subprocess (scripts/tts_silero.py). Dispatched through the unified
// PipelineQueueService FIFO — same single-slot serialisation as GPU work, so
// rendering a TTS doesn't race with a scene/video render and vice versa.

model TTSJob {
  id             String    @id @default(uuid())
  /// Owner: either a Scene or a Shot, never both. Scene-level (legacy) =
  /// single long voiceover per scene saved to data/<slug>/scenes/<sceneKey>/.
  /// Shot-level (current default for night_courier-style projects) = one ~5s
  /// voiceover per shot saved to data/<slug>/shots/<shotCode>/. A row with
  /// both null is a bug; service code enforces exactly-one-of.
  sceneId        String?
  shotId         String?
  /// Engine snapshot at enqueue time. 'silero' = Silero V5 ru worker;
  /// 'xtts2' = XTTS-v2 voice-clone worker; 'f5' = F5-TTS Russian voice-clone
  /// worker. Null = legacy rows pre-dating the field; treat as 'silero'.
  engine         String?
  /// Text snapshot at enqueue time. Editing narration text later does NOT
  /// retroactively change rendered audio — re-queue to regenerate.
  text           String
  /// Silero speaker id (silero engine only). V5 voices: aidar | baya |
  /// kseniya | xenia | eugene. V3/V4 add: ruslan | random.
  /// Ignored by the voice-clone engines (xtts2 / f5).
  voice          String
  /// Which .pt model file under .silero_cache/ was used. Null = auto-pick by
  /// MODEL_FILENAMES precedence (V5_5 wins). Example: "v3_1_ru.pt", "v4_ru.pt".
  modelFilename  String?
  /// Emotion preset, one of: neutral | happy | sad | angry | fear | disgust |
  /// surprise | calm. Null = neutral. INERT today: both voice-clone engines
  /// (xtts2, f5) ignore the categorical preset — tone comes from the speaker
  /// clip. Kept as a snapshot/allow-list for a future categorical engine.
  emotionPreset    String?
  /// Emotion intensity [0.0–1.0]. Null = 0.5. INERT today (see emotionPreset).
  emotionIntensity Float?
  /// User-uploaded emotion reference name (matches ProjectTTSEmotionRef.name).
  /// This is the knob that actually changes tone on xtts2/f5 (swaps the speaker
  /// clip for the render). Overrides emotionPreset. Ignored for silero.
  emotionRefName   String?
  /// Output sample rate: 8000 | 24000 | 48000 (Silero supports these three).
  sampleRate     Int
  /// Playback rate (1.0 = normal, <1 slower, >1 faster). Applied via
  /// post-synthesis waveform resampling in the Python worker — Silero
  /// TTSModelMultiAcc_v3 (v5) doesn't expose `apply_ssml`.
  rate           Float     @default(1.0)
  /// Extra silence to insert after every sentence boundary (in seconds).
  /// 0 = no extra pause; documentary narration commonly uses 3-5s so the
  /// editor can drop B-roll between beats. The Python worker splits on
  /// [.!?…]+, synthesises each chunk separately, then concatenates with
  /// `silence = zeros(int(sr * pause_sec))` between.
  sentencePauseSec Float   @default(0)
  status         String    // pending | running | completed | failed | cancelled
  /// Basename of the wav. Scene-level jobs live in
  /// data/<slug>/scenes/<sceneKey>/, shot-level jobs in
  /// data/<slug>/shots/<shotCode>/.
  outputFilename String?
  /// Actual wav duration in milliseconds — probed from the RIFF header on
  /// completion (or backfilled when an older row is first read by the scenes
  /// endpoint). Null = not yet measured; UI falls back to the text-length
  /// heuristic (text.length / 15 cps) until populated.
  durationMs     Int?
  errorMessage   String?
  queuedAt       DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  scene Scene? @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shot  Shot?  @relation(fields: [shotId],  references: [id], onDelete: Cascade)

  @@index([sceneId])
  @@index([shotId])
  @@index([status, queuedAt])
  @@map("tts_jobs")
}

// ─── Voice-clone emotion references (per-project library) ────────────────────
//
// Each project on a voice-clone engine (xtts2 / f5) has one voice reference
// (Project.ttsVoiceRefPath) that defines WHO speaks, plus an arbitrary number
// of named "emotion references" — short clips (~3–8s) of someone speaking
// with the target prosody (tired, anxious, whispering, …). A shot's TTS job
// can pick one by name; the worker uses it AS the speaker clip for that render
// (these engines have no separate emotion path). Optional.

model ProjectTTSEmotionRef {
  id        String   @id @default(uuid())
  projectId String
  /// User-defined identifier, unique per project. Lowercase ASCII recommended
  /// (e.g. "tired", "exhausted", "whisper"). Picked from a dropdown / typed
  /// into autocomplete on the shot narration UI.
  name      String
  /// Project-relative wav path. Convention:
  /// data/<slug>/tts/emotion_refs/<name>.wav.
  filePath  String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@map("project_tts_emotion_refs")
}

// ─── BGM (ACE-Step v1.5 background music) ────────────────────────────────────
//
// Narrative-block-driven background music. A project is split into a small
// number of NarrativeBlocks ("Старт", "Рост", "Выгорание", …) whose target
// duration equals the sum of the shots they cover. Each block is auto-filled
// with one or more MusicSegment rows (30–90s typical, ACE-Step ceiling ~4 min)
// until total segment duration meets the block's target. Each segment owns its
// AudioRenderJob history (status + comfyPromptId + flac on disk), same lifecycle
// as VideoRender. All ACE-Step jobs go through PipelineQueueService — single-slot
// FIFO with image/video/training so the GPU never gets two music jobs at once.
//
// All English prompts/tags in DB content — Russian breaks ACE-Step tokenizer
// the same way it breaks CLIP for SDXL.

model NarrativeBlock {
  id        String   @id @default(uuid())
  projectId String
  /// Stable identifier for the block within the project. English. e.g. "start",
  /// "growth", "burnout". Used in filesystem paths data/<slug>/bgm/<blockSlug>/.
  slug      String
  /// Human-friendly title for the UI. Russian is fine here — never sent to ACE.
  title     String?
  sortOrder Int      @default(0)
  /// Default ACE-Step tag prompt inherited by every segment unless overridden.
  /// English comma-separated tags (e.g. "cinematic, warm, hopeful, piano").
  moodPrompt String?
  /// Ordered array of Shot.id strings this block covers. Source of truth for
  /// `targetSeconds` — kept as JSON instead of a join table because order matters
  /// and the block's "shape" is rarely edited (set once during script breakdown).
  shotIds   Json
  /// Cached sum of shot durations in seconds. Recomputed when shotIds changes
  /// or shot videos are re-rendered with new lengths.
  targetSeconds Int?
  /// Lifecycle: filling (auto-fill loop active) | filled (sum(segments) >=
  /// targetSeconds, idle) | manual (user took over, no auto-fill).
  status    String   @default("filling")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  segments MusicSegment[]

  @@unique([projectId, slug])
  @@index([projectId, sortOrder])
  @@map("narrative_blocks")
}

model MusicSegment {
  id          String   @id @default(uuid())
  blockId     String
  sortOrder   Int      @default(0)
  /// Override of block.moodPrompt for this segment. English ACE-Step tags. Null
  /// = use block default. Lets an arc inside one block ("warm → tense → release").
  prompt      String?
  /// Target seconds for this segment. Final flac length is decided by ACE-Step
  /// (driven by node `EmptyAceStep1.5LatentAudio.seconds`); this is the request.
  durationSec Int      @default(60)
  /// AudioRenderJob.id chosen as the canonical take for this segment. Plain id,
  /// no FK — mirrors approvedTTSJobId convention, so deleting a job row doesn't
  /// cascade-null the segment.
  approvedJobId String?
  createdAt   DateTime @default(now())

  block NarrativeBlock     @relation(fields: [blockId], references: [id], onDelete: Cascade)
  jobs  AudioRenderJob[]

  @@index([blockId, sortOrder])
  @@map("music_segments")
}

model AudioRenderJob {
  id               String    @id @default(uuid())
  segmentId        String
  status           String    // pending | running | completed | failed | cancelled
  /// ComfyUI prompt_id once dispatched.
  comfyPromptId    String?
  /// Render parameters at enqueue time: { seed, steps, cfg, samplerName,
  /// scheduler, durationSec, prompt }. Snapshotted so the worker can rebuild
  /// the workflow after a backend restart.
  params           Json?
  /// Workflow filename used (under data/<slug>/comfy/). Default points at
  /// the ACE-Step text-to-audio template.
  workflowFilename String    @default("bgm_acestep_api.json")
  /// Basename of the rendered flac in data/<slug>/bgm/<blockSlug>/.
  outputFilename   String?
  errorMessage     String?
  queuedAt         DateTime  @default(now())
  startedAt        DateTime?
  completedAt      DateTime?

  segment MusicSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([segmentId])
  @@index([status, queuedAt])
  @@map("audio_render_jobs")
}

/// Anchor portrait render jobs. Cartoon-style identity is locked via IP-Adapter
/// on a single anchor PNG per character profile. This table tracks the queue
/// of "render an anchor for this profile via ComfyUI" jobs the same way
/// scene_render_jobs tracks shot renders. PipelineQueueService.tick() dispatches
/// pending rows one at a time. See AnchorRenderService.
model AnchorRenderJob {
  id              String    @id @default(uuid())
  profileId       String
  status          String    @default("pending")
  /// ComfyUI prompt_id once dispatched. Null until status moves from pending → running.
  comfyPromptId   String?
  /// Absolute on-disk path of the saved anchor PNG once completed.
  outputPath      String?
  errorMessage    String?
  queuedAt        DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  profile CharacterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([status, queuedAt])
  @@map("anchor_render_jobs")
}

/// Visual-style registry. Each row defines a complete style: style-block tokens
/// (prepended to shot prompts), default negative, identity-stack strategy
/// (LoRA face-lock vs IP-Adapter vs IP-Adapter + style-LoRA), LoRA pipeline
/// kind (character training vs none vs style-only), and references to workflow
/// templates used for shots in this style. Project.visualStyle FKs here.
/// See docs/VISUAL_STYLE_ARCHITECTURE.md.
model VisualStyle {
  id                     String   @id
  displayName            String
  styleBlock             String
  defaultNegative        String
  identityStack          String
  loraPipeline           String
  characterIpTemplateKey String?
  environmentTemplateKey String?
  datasetTemplateKey     String?
  loraTrainTemplateKey   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  @@map("visual_styles")
}
