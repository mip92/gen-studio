generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Project ─────────────────────────────────────────────────────────────────

model Project {
  id                        String    @id @default(uuid())
  slug                      String    @unique
  name                      String
  settings                  Json?
  /// Full narration script for the project (Markdown). Source of truth lives
  /// in the database so the API can serve it without depending on filesystem
  /// state. Scenes hold their own snippet of this in Scene.narrationText.
  scriptText                String?
  /// Distribution target: "youtube" | "tiktok" | "shorts" | "longform".
  /// Drives platform-specific safety/length checks at shotlist time.
  targetPlatform            String?
  /// Safety tier for advertiser-friendliness checks. "advertiser_safe" =
  /// strict YouTube monetization guardrails (no self-harm, no graphic violence,
  /// no brands, etc.); "limited" = age-gate acceptable; "unrestricted" = no
  /// filtering. Default null = unrestricted. Applied by shotlist generator
  /// and prompt sanitizer.
  safetyTier                String?
  /// Canonical negative prompt for every shot in this project. SDXL accepts it
  /// verbatim. Single source of truth — `Shot.promptFields.negative` is treated
  /// as a per-shot override; if absent or empty the renderer reads this value.
  /// Lets editing happen in one place instead of touching all shots.
  ///
  /// **Required** (NOT NULL + CHECK non-empty) — every project must define its
  /// own. See AGENTS.md §1, §6.
  defaultNegative           String
  /// Canonical negative prompt for the i2v / video model (Wan2.2 etc.). Same
  /// fallback chain as `defaultNegative` but for video render workflows.
  /// Per-shot override lives in `Shot.promptFields.motionNegative`.
  /// **Required** (NOT NULL + CHECK non-empty).
  defaultVideoNegative      String
  /// Default motion-prompt text used when a video render has no explicit
  /// motion prompt and the shot is NOT marked static. Per-shot override:
  /// `Shot.promptFields.motionPrompt`.
  /// **Required** (NOT NULL + CHECK non-empty).
  defaultMotionPrompt       String
  /// Default motion-prompt text used when a video render has no explicit
  /// motion prompt AND `Shot.promptFields.camera.movement` starts with
  /// "static". Should be a strong "freeze frame, no motion" directive.
  /// **Required** (NOT NULL + CHECK non-empty).
  defaultStaticMotionPrompt String
  /// Which i2v flow every shot in this project uses by default.
  ///   "i2v"   — (default) one conditioning frame. `WanImageToVideo`: the shot's
  ///             chosenRender is pinned to frame 0 and the remaining 80 frames
  ///             are free. This is what every project rendered before 2026-08-15.
  ///   "flf2v" — two conditioning frames. `WanFirstLastFrameToVideo`: chosenRender
  ///             is pinned to frame 0 AND an approved end frame is pinned to the
  ///             last frame, so drift has nowhere to accumulate. Costs one extra
  ///             Qwen-edit image + an approval per shot.
  /// Overridable per act (`Scene.defaultVideoFlow`) and per shot (`Shot.videoFlow`).
  /// Default is "i2v" precisely so every pre-existing project keeps rendering the
  /// byte-identical graph it always did; new projects opt in.
  defaultVideoFlow          String    @default("i2v")
  /// Which model family renders this project's clips: "wan" (Wan 2.2 i2v, the
  /// original and the default) or "ltx" (LTX-2.5). Chosen per PROJECT, like
  /// `visualStyle` for stills — one film is shot on one engine so a single
  /// montage never mixes two grains, and there is deliberately no per-shot
  /// override (user 2026-08-16).
  ///
  /// Resolved through `VideoEngineFactory`; an unknown value falls back to wan
  /// rather than failing, so a film mid-production keeps rendering.
  videoEngine               String    @default("wan")
  /// TTS engine to use for narration synthesis. 'silero' = CPU Silero V5 ru
  /// (default; legacy projects); 'xtts2' = XTTS-v2 GPU voice cloning;
  /// 'f5' = F5-TTS Russian GPU voice cloning. Null = treat as 'silero'.
  /// Endpoints branch on this field.
  ttsEngine                 String?
  /// Project-relative path to the single voice reference wav used by the
  /// voice-clone engines (xtts2 / f5). Convention:
  /// data/<slug>/tts/voice_reference.wav. Null = not uploaded yet (renders
  /// fail with a clear error until set when ttsEngine is a voice-clone engine).
  ///
  /// MIRROR FIELD: when `ttsVoiceoverId` is set, this is kept in sync to the
  /// assigned Voiceover's shared `filePath` so all render/gating code can keep
  /// reading this single field. Direct legacy uploads still populate it too.
  ttsVoiceRefPath           String?
  /// FK to a shared Voiceover (закадровая озвучка) in the reusable library.
  /// Assigning a library voice sets this AND mirrors `ttsVoiceRefPath` to the
  /// voiceover's shared file — so a voice lives ONCE on disk and is referenced
  /// by many projects instead of copied into each. Null = no library voice
  /// assigned. onDelete: SetNull (deleting a voiceover unassigns, never cascades
  /// a project away).
  ttsVoiceoverId            String?
  /// Visual style of this project. Drives workflow routing + LoRA pipeline +
  /// style-block injection into shot prompts. References visual_styles.id.
  /// Default photoreal_cinematic for backwards compatibility with last_shift /
  /// night_courier. See docs/VISUAL_STYLE_ARCHITECTURE.md.
  visualStyle               String    @default("photoreal_cinematic")
  /// How shot durations are timed on the CapCut export timeline.
  /// "clip"      = (legacy, default) each animated shot occupies exactly its
  ///               rendered clip length (length/fps); static shots fall back to
  ///               narration-or-default. Keeps last_shift / bio_plus exports
  ///               byte-identical.
  /// "narration" = every shot is held for the length of its voiceover. Animated
  ///               clips are slowed (CapCut speed) to fill the VO; static frames
  ///               are held with a slow Ken-Burns move. This is the long-form
  ///               (~45 min) model where only the first minutes are animated and
  ///               the rest are stills. See exports.service + export_capcut.py.
  exportTiming              String    @default("clip")
  /// Published YouTube URL of the FINISHED video. When set, the project is
  /// considered DONE: the /actions page suppresses every pipeline gate for it
  /// (no more render/upscale/FPS/TTS nagging — the deliverable already shipped).
  /// Null = still in production. Set/cleared from the project overview page.
  youtubeUrl                String?
  /// Release calendar instant (naive column = UTC, DB-wide convention).
  /// youtubeUrl set  → FACTUAL publish time, owned by the YouTube backfill sync
  ///                   (ReleaseBackfillService) and locked from hand edits.
  /// youtubeUrl null → PLANNED slot (Tue/Thu 13:00 channel wall clock default).
  /// Null = not scheduled. NEVER feeds queuePriorityTier — the calendar is
  /// informational only; render priority stays a manual queue decision.
  releaseAt                 DateTime?
  /// Opt-in gate for VO validation (audio QC of rendered narration): when true,
  /// approving ANY TTS take in this project is blocked until the project has at
  /// least one COMPLETED VoValidationRun. Default false so existing in-flight
  /// projects keep approving without ever running QC (same opt-in discipline as
  /// comic_pages / Wan guard mode). Individual flagged verdicts never block —
  /// the gate is only "QC has run at least once".
  voValidationGateEnabled   Boolean   @default(false)
  /// Queue priority tier for "render this film first". 0 = normal. Higher wins,
  /// evaluated BEFORE QueueEntry.rank, so raising it moves the project's whole
  /// backlog — present AND future jobs — ahead of every lower-tier project
  /// without rewriting a single queue row. Ties inside a tier keep their rank
  /// order, so a project's internal ordering is preserved across a boost.
  queuePriorityTier         Int       @default(0)
  /// When the current tier was set. Newest boost wins among equal tiers, so
  /// "prioritise this one now" beats a project boosted last week.
  queuePrioritizedAt        DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  characters        Character[]
  characterLinks    ProjectCharacter[]
  scenes            Scene[]
  shots             Shot[]
  locations         Location[]
  referenceAssets   ReferenceAsset[]
  narrativeBlocks   NarrativeBlock[]
  ttsEmotionRefs    ProjectTTSEmotionRef[]
  thumbnailJobs     ThumbnailJob[]
  props             Prop[]
  thumbnailIdeaJobs ThumbnailIdeaJob[]
  comicPages        ComicPage[]
  voValidationRuns  VoValidationRun[]
  imageQcRuns       ImageQcRun[]
  videoQcRuns       VideoQcRun[]
  ttsVoiceover      Voiceover?             @relation(fields: [ttsVoiceoverId], references: [id], onDelete: SetNull)

  @@index([ttsVoiceoverId])
  @@map("projects")
}

// ─── Characters ──────────────────────────────────────────────────────────────

model Character {
  id          String   @id @default(uuid())
  /// Legacy "creator project" reference. Null = library character (no creator project).
  /// Project participation is the source of truth via the `project_characters` join (see ProjectCharacter).
  /// Phase 2 will drop this column once existing characters are migrated to the library FS layout
  /// (`data/_characters/<code>/<profileCode>/...`) and all legacy `data/<slug>/datasets/<code>/`
  /// paths are repointed.
  projectId   String?
  code        String
  displayName String?
  createdAt   DateTime @default(now())

  /// Legacy back-reference to the "creator project". onDelete: SetNull so that
  /// deleting a project leaves library characters orphaned rather than cascade-deleted.
  /// Real project membership lives in `project_characters`.
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  profiles         CharacterProfile[]
  shotParticipants ShotParticipant[]
  /// M:N to projects. A character can be attached to any number of projects.
  projectLinks     ProjectCharacter[]
  referenceAssets  ReferenceAsset[]

  @@unique([projectId, code])
  @@map("characters")
}

/// Many-to-many join: which projects a character is attached to. A character
/// can live in the library (no rows here) or be attached to one or more
/// projects. Replacing the old "Character.projectId" hard-binding so projects
/// can share LoRAs / datasets.
model ProjectCharacter {
  projectId   String
  characterId String
  attachedAt  DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([projectId, characterId])
  @@index([characterId])
  @@map("project_characters")
}

model CharacterProfile {
  id            String   @id @default(uuid())
  characterId   String
  profileCode   String
  ageLabel      String?
  targetImages  Int?
  promptBase    String
  negative      String?
  promptAngles  String?
  promptVariety String?
  datasetPath   String?
  /// "Active" LoRA — the one used by default for scene rendering. Defaults to
  /// the final epoch from the most recent successful training; user can switch
  /// to any entry in `loraVariants` via the UI to test intermediate checkpoints.
  loraPath      String?
  /// All trained LoRA files for this profile (final + epoch checkpoints from
  /// every successful training run). Each entry is { filename, fullPath, epoch?, sizeBytes, mtime, label }.
  /// Latest training overwrites this list to reflect current disk state.
  loraVariants  Json?
  triggerToken  String?
  /// If true, this profile is rendered without LoRA and identity is locked
  /// via IP-Adapter FaceID (or PuLID) using a single reference portrait.
  /// Used for "passenger"-style minor characters where training a LoRA per
  /// person is uneconomical. The reference image lives in ReferenceAsset
  /// for this profileCode (sortOrder = 0 is the FaceID anchor).
  useIpAdapter  Boolean  @default(false)
  /// Anchor inheritance: the profile this one DERIVES from — the same person in
  /// an earlier state (`X_MID.baseProfileId = X_YOUNG.id`). When set, the anchor
  /// render is a Qwen-Image-Edit of the base profile's installed anchor instead
  /// of an independent text-to-image, so age/state variants keep the face.
  /// Must point at another profile of the SAME character; cycles are rejected
  /// in AnchorRenderService.setBaseProfile. Chains follow story time, so aging
  /// accumulates: X_KID → X_YOUNG → X_MID → X_OLD.
  baseProfileId String?
  /// When the USER approved the installed anchor portrait. NULL = an anchor may
  /// well exist on disk, but only the machine has seen it: both the validator's
  /// automatic pick and a fresh render land unapproved. Cleared again whenever a
  /// new render replaces the image, so approval always refers to the exact
  /// portrait currently installed. Scene rendering refuses to run for a
  /// participant whose anchor is unapproved.
  anchorApprovedAt DateTime?
  createdAt     DateTime @default(now())

  character            Character             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  datasetJobs          DatasetJob[]
  trainingJobs         TrainingJob[]
  shotParticipants     ShotParticipant[]
  anchorRenderJobs     AnchorRenderJob[]
  anchorValidationJobs AnchorValidationJob[]
  /// Self-relation for anchor inheritance. SetNull so deleting a base profile
  /// degrades its descendants to independent t2i renders instead of cascading.
  base                 CharacterProfile?     @relation("ProfileBase", fields: [baseProfileId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  derived              CharacterProfile[]    @relation("ProfileBase")

  @@unique([characterId, profileCode])
  @@index([baseProfileId])
  @@map("character_profiles")
}

// ─── Reference Assets ────────────────────────────────────────────────────────

model ReferenceAsset {
  id          String   @id @default(uuid())
  /// Legacy project scope. Null = library asset (owned by character). Kept nullable for Phase 1 backwards compat;
  /// Phase 2 will drop this and `profileCode` once all rows have `characterId` populated.
  projectId   String?
  /// Legacy soft-deprecated profile code key. Use `characterId` as the canonical owner going forward.
  profileCode String
  /// Canonical owner of the reference asset. Backfilled from (projectId, profileCode → profile → character).
  /// Library assets must have this set.
  characterId String?
  path        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([projectId, profileCode])
  @@index([characterId])
  @@map("reference_assets")
}

// ─── Scenes (= ACTS) ─────────────────────────────────────────────────────────
// Terminology: a Scene row IS an act of the film («Акт N — …», sceneKey "A3" /
// "act_03_*"). There is no separate "scene" level between act and shot — the
// model/table name is historical. NarrativeBlock mirrors the same acts for BGM.

model Scene {
  id                          String   @id @default(uuid())
  projectId                   String
  sceneKey                    String
  title                       String?
  sortOrder                   Int      @default(0)
  defaultReferenceProfileCode String?
  /// LEGACY whole-act voiceover text (used by night_courier-era projects only;
  /// current projects narrate per shot via Shot.narrationText). TTS writes the
  /// wav to data/<slug>/scenes/<sceneKey>/narration_<jobId>_<voice>_<rate>.wav.
  /// Edits don't retroactively change rendered TTSJob outputs — each job
  /// snapshots `text` at enqueue time.
  narrationText               String?
  /// User-approved TTS job for this scene — the "this is the one we ship"
  /// pick from the rendered history. Null = nothing approved yet. Stored as
  /// a plain id (no FK) so deleting a TTSJob row doesn't cascade-null the
  /// scene state; the UI just shows no approval if the id stops resolving.
  approvedTTSJobId            String?
  /// Reference to the project narration script: which lines in
  /// <slug>_script.md this scene covers (inclusive). Lets the UI link back
  /// "scene → source paragraphs" without duplicating ranges in code.
  scriptStartLine             Int?
  scriptEndLine               Int?
  /// Dramaturgical role of this act in the project's act structure (projects
  /// typically use 8-12 acts, not a strict 5-act Freytag). Free-form per
  /// project — typical values: "setup" | "rising" | "midpoint" | "climax" |
  /// "resolution". NOTE: seeded as planning metadata; no backend code reads it.
  actBeat                     String?
  /// Default palette key for shots in this scene. Project-specific token
  /// (e.g. "S01_sodium", "S04_dark_emerald"). Individual shots can override
  /// via Shot.paletteKey; this is the inherited default for atmosphere
  /// consistency across the scene.
  defaultPaletteKey           String?
  /// Default time-of-day for shots in this scene. Project-specific token
  /// (e.g. "sunset_day1", "night_day2", "dawn_day2"). Shot.timeOfDay
  /// overrides this when set.
  defaultTimeOfDay            String?
  /// Single canonical lighting-tokens string for every shot in this act
  /// (e.g. "warm tungsten corridor lamps, deep indigo night windows, soft
  /// falloff, sleep silence"). NOTE: planning metadata only — the prompt
  /// composer that read it was removed 2026-07-04 (renderer uses pf.positive
  /// verbatim); nothing in the backend reads this column anymore.
  lightingMood                String?
  /// Override of Project.defaultVideoFlow for every shot in this act
  /// ("i2v" | "flf2v"). Null = inherit the project. Same inheritance idiom as
  /// defaultPaletteKey / defaultTimeOfDay: an act that is all quiet talking
  /// heads can stay on the cheap one-frame flow while an act full of movement
  /// runs on two frames.
  defaultVideoFlow            String?
  createdAt                   DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots   Shot[]
  ttsJobs TTSJob[]

  @@unique([projectId, sceneKey])
  @@map("scenes")
}

// ─── Shots ───────────────────────────────────────────────────────────────────

model Shot {
  id                   String   @id @default(uuid())
  projectId            String
  sceneId              String
  shotCode             String
  promptFields         Json?
  workflowRouteKey     String?
  referenceProfileId   String?
  referenceImagePool   Json?
  /// Accumulated rendered candidates for this shot.
  /// Shape: [{filename, promptId, seed, strategyId, createdAt}]
  renderedImages       Json?
  /// Filename of the candidate chosen as the canonical render for this shot.
  chosenRender         String?
  /// VideoRender.id chosen as the final/approved animation for this shot.
  /// Mirrors `chosenRender` for videos: once set, the scenes UI offers an upscale
  /// instead of another render, and downstream packaging treats this as the
  /// canonical motion clip. No FK so the row stays self-consistent if the video
  /// is hard-deleted; the setChosenVideo service validates membership.
  chosenVideoId        String?
  /// Final-cut render mode for this shot.
  /// "animated" = (default) the shot is rendered to a Wan2.2 i2v clip and FHD-
  ///              upscaled; the CapCut export lays the mp4 on the timeline.
  ///              Export readiness requires a chosen video + completed upscale.
  /// "static"   = the shot ships as its still PNG (chosenRender) only — no video
  ///              render, no upscale. The CapCut export lays the image on the
  ///              timeline and adds a slow Ken-Burns move (zoom/pan/rotate). Used
  ///              for the long-form model where only the first minutes are
  ///              animated. Export readiness requires only a chosenRender PNG.
  renderMode           String   @default("animated")
  /// Latest in-flight ComfyUI prompt_id for this shot (cleared once result is recorded).
  activeRenderPromptId String?
  /// Per-shot narration text (Russian, ~5s of voiceover per shot). When set,
  /// the shot gets its own TTSJob → wav, and CapCut export lays each wav at
  /// the shot's video timeline position. Independent of Scene.narrationText
  /// (which is the legacy whole-scene voiceover and is kept for backward
  /// compatibility with other projects that still use scene-level narration).
  narrationText        String?
  /// User-approved TTSJob for this shot. Plain id (no FK) so deleting the
  /// TTSJob row doesn't cascade-null the shot state — UI just shows nothing
  /// approved if the id stops resolving. Mirrors Scene.approvedTTSJobId.
  approvedTTSJobId     String?
  /// Camera framing for this shot. Canonical values: "EWS" | "WS" | "MS" |
  /// "MCU" | "CU" | "ECU" | "OTS" | "BACK" | "POV". First-class column
  /// (not promptFields jsonb) so quota-checking and shot-variety enforcement
  /// can SQL-query distribution without parsing JSON. See [[feedback_shot_variety]].
  shotType             String?
  /// Camera angle. Canonical values: "eye" | "low" | "high" | "dutch".
  cameraAngle          String?
  /// Camera movement. Canonical values: "static" | "track_lateral" |
  /// "push_in" | "pull_out" | "window_pov" | "locked_off" | "handheld" |
  /// "pan_left" | "pan_right" | "tilt_up" | "tilt_down" |
  /// "arc_left" | "arc_right".
  ///
  /// An ARC is the camera travelling AROUND the subject (added 2026-08-15); a
  /// PAN turns the camera on its own axis and lets the subject slide out of
  /// frame. They are different moves and both are needed.
  ///
  /// TWO moves may be combined with `+`, primary first: `arc_left+push_in` =
  /// the camera arcs around the subject while closing on it. The second part is
  /// rendered as a `while …` clause on the clip and as a compact addition on the
  /// end frame, so both channels state ONE combined move rather than two
  /// competing ones. Three or more parts are ignored past the second.
  ///
  /// This ONE column feeds two places that must never disagree: the clip's
  /// camera clause (`CAMERA_CLAUSE` + `CAMERA_SECONDARY`, video-render.service.ts)
  /// and, on the two-frame flow, the end frame's viewpoint
  /// (`END_FRAME_CAMERA_MOVE` + `END_FRAME_CAMERA_ALSO`, qwen-prompt.ts).
  /// Adding a value means adding it to all four maps.
  cameraMove           String?
  /// Dramaturgical beat this shot serves. Project-specific token, e.g.
  /// "opening_image", "catalyst", "midpoint_twist", "all_is_lost",
  /// "break_into_three", "final_image". Lets the shotlist tool verify every
  /// shot earns its place in the plot.
  storyBeat            String?
  /// What this shot is doing narratively: "plot" | "character" | "atmosphere"
  /// | "transition" | "iconic". Helps balance the act so atmosphere-only
  /// shots don't crowd out plot-advancing ones.
  narrativeFunction    String?
  /// Which character/passenger vignette this shot belongs to. Free-form
  /// slug per project (e.g. "military", "mother_baby", "child_girl",
  /// "conductor"). Lets the shotlist verify each vignette gets its quota
  /// of shots and that beats are spread inside the vignette.
  vignetteSlug         String?
  /// True if this shot has no main characters (pure exterior, object macro,
  /// landscape). Used to enforce the ~15% B-roll quota that night_courier
  /// lacked. Mutually compatible with isIconic.
  isBroll              Boolean  @default(false)
  /// True if this shot is intentionally designed to be screenshot-worthy —
  /// composition, lighting and prop arrangement curated for thumbnail /
  /// preview use. Project should target ~1 iconic frame per 20-25 shots.
  isIconic             Boolean  @default(false)
  /// Override of Scene.defaultTimeOfDay. Project-specific token. Null =
  /// inherit from scene.
  timeOfDay            String?
  /// Override of Scene.defaultPaletteKey. Project-specific token. Null =
  /// inherit from scene.
  paletteKey           String?
  /// FK to the Location row whose `description` gets prepended into the
  /// shot's positive prompt at render time. Null = no location injection
  /// (use raw promptFields.positive verbatim). Set per-shot so a single
  /// canonical "interior of cramped Soviet train kupe" description can be
  /// reused by 90% of shots without duplicating prose in every promptFields.
  locationId           String?
  /// Prop displayed in this shot. Added to the LIVE DB by hand (2026-07,
  /// props entity) before it ever appeared in this schema; declared here
  /// 2026-08-01 so `prisma db push` stops trying to drop it. Matches the live
  /// DDL: plain text, no FK (props.controller talks to props via $queryRaw).
  /// The render path does not read it yet.
  propId               String?
  /// FK to the ComicPage this shot is planned into (template-layout mode).
  /// Null = legacy/uniform mode — the shot renders at the default sizes and
  /// the comic export uses the old row-major grid. Seeded by SQL during
  /// project planning, BEFORE the script is written: the page-template plan
  /// comes first, the story beat is then written to fit the panel's shape.
  comicPageId          String?
  /// Slot index inside comicPage's template (0-based; must exist in the
  /// template and be unique within the page). Null when comicPageId is null.
  comicSlot            Int?
  /// Denormalized panel shape ("wide" | "landscape" | "square" | "tall") —
  /// first-class column like storyBeat/vignetteSlug so SQL audits and the
  /// render services read it without joining into the template registry.
  /// Source of truth is template.slots[comicSlot].shape; the comic-plan gate
  /// verifies this column agrees with it. Null = render at legacy sizes.
  comicPanelShape      String?
  /// Override of Scene.defaultVideoFlow → Project.defaultVideoFlow for THIS shot
  /// ("i2v" | "flf2v"). Null = inherit. Resolution is
  /// `shot.videoFlow ?? scene.defaultVideoFlow ?? project.defaultVideoFlow`.
  videoFlow            String?
  /// Qwen-Image-Edit-2511 instruction that turns this shot's `chosenRender` into
  /// its END frame — i.e. what has CHANGED five seconds later, and nothing else
  /// ("she is now standing, palm flat on the door handle"). The end frame is an
  /// EDIT of the start frame, never a fresh generation: re-generating would give
  /// a different face and Wan would spend the clip morphing between two people.
  ///
  /// Empty on a flf2v shot means "no end frame planned here" — the /actions gate
  /// skips it, and the shot cannot start a video until either a prompt is written
  /// or the shot is flipped back to "i2v".
  endFramePrompt       String?
  /// Rendered end-frame candidates, same shape as `renderedImages`:
  /// [{filename, promptId, seed, createdAt}]. Files live in
  /// `data/<project>/shots/<shotCode>/endframes/`.
  endFrameRenders      Json?
  /// Basename of the end-frame candidate picked as canonical. Mirrors
  /// `chosenRender` for the last frame.
  chosenEndFrame       String?
  /// When the chosen end frame was approved for animation. Mirrors
  /// `CharacterProfile.anchorApprovedAt`: a flf2v shot REFUSES to start a video
  /// until this is set, because a bad end frame does not degrade the clip — it
  /// dictates the last thing the viewer sees, and the GPU time is spent either
  /// way. Cleared whenever `chosenEndFrame`, `endFramePrompt` or the shot's
  /// `chosenRender` changes, since all three invalidate the approval.
  endFrameApprovedAt   DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene          Scene                @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  location       Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  comicPage      ComicPage?           @relation(fields: [comicPageId], references: [id], onDelete: SetNull)
  participants     ShotParticipant[]
  renderJobs       SceneRenderJob[]
  endFrameJobs     EndFrameJob[]
  videoRenders     VideoRender[]
  ttsJobs          TTSJob[]
  validationJobs   ImageValidationJob[]
  imageQcVerdicts  ImageQcVerdict[]

  @@unique([projectId, shotCode])
  @@index([projectId, sceneId])
  @@index([projectId, shotType])
  @@index([projectId, vignetteSlug])
  @@index([projectId, isBroll])
  @@index([projectId, isIconic])
  @@index([locationId])
  @@index([propId])
  @@index([comicPageId])
  @@index([projectId, comicPanelShape])
  @@index([projectId, videoFlow])
  @@map("shots")
}

/// One planned page of the comic book (template-layout mode). The PRESENCE of
/// any row for a project is the single mode switch: comic_manifest.py counts
/// rows and takes the template branch; zero rows = the untouched legacy
/// uniform grid. The plan is seeded by SQL as the FIRST step of a comic
/// project — before the script is written — and is then immutable by
/// convention (the story adapts to the panel shapes, not the other way).
/// A spread = the page pair (pageIndex 2k, 2k+1); an odd tail leaves the
/// last spread's right page as empty paper, like a real book's last leaf.
model ComicPage {
  id          String   @id @default(uuid())
  projectId   String
  /// Position in the book, dense 0..N-1 per project (gate-validated).
  pageIndex   Int
  /// Id of the layout in scripts/comic_page_templates.json. Not an FK — the
  /// registry is a file, same principle as settings.comicDeskProps items;
  /// the comic-plan gate validates it against the registry.
  templateId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots   Shot[]

  @@unique([projectId, pageIndex])
  @@map("comic_pages")
}

/// Reusable location description per project. One row per setting
/// (train kupe, train corridor, train vestibule, station platform, snow
/// field, etc.). The `description` is rich prose that gets prepended into
/// the rendered positive prompt for any shot tagged with this location.
/// Edit once → every shot using this location updates.
model Location {
  id          String   @id @default(uuid())
  projectId   String
  slug        String
  name        String
  /// SDXL-ready prose, e.g. "interior of cramped narrow old Soviet
  /// long-distance passenger train kupe compartment, very tight space, two
  /// narrow lower berths and two narrow upper berths only (NO double beds),
  /// painted wood-and-frosted-glass door, single small window with curtain,
  /// indigo night outside, warm tungsten reading lamp, NOT outside, NOT at
  /// a platform, NOT in an apartment". Prepended to shot positive prompts.
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots   Shot[]

  @@unique([projectId, slug])
  @@map("locations")
}

model ShotParticipant {
  id          String  @id @default(uuid())
  shotId      String
  characterId String?
  /// Which character profile (LoRA + age variant) to use for this participant
  /// in this specific shot. Null = renderer falls back to the first profile
  /// of the character that has a trained LoRA.
  profileId   String?
  label       String

  shot      Shot              @relation(fields: [shotId], references: [id], onDelete: Cascade)
  character Character?        @relation(fields: [characterId], references: [id], onDelete: SetNull)
  profile   CharacterProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@map("shot_participants")
}

// ─── Workflow ─────────────────────────────────────────────────────────────────
//
// There is no workflow table. Every ComfyUI graph lives once, on disk, in
// data/_templates/comfy/, resolved by src/comfy/workflow-path.ts. The old
// workflow_templates / workflow_routes / workflow_route_steps trio mirrored the
// per-project copy layout and was never read at dispatch — dropped 2026-08-13
// (migration 20260813120000_drop_dead_workflow_tables).

// ─── Training ─────────────────────────────────────────────────────────────────

model DatasetJob {
  id                     String    @id @default(uuid())
  profileId              String
  status                 String // pending | blocked | running | completed | failed | cancelled
  /// If set, this job waits until the named profile's dataset has at least one image.
  dependsOnProfileId     String?
  /// If set, the reference image used by ComfyUI is picked from this profile's
  /// dataset folder (chaining: HERO_TEEN_15 → HERO_OVERLOAD_16/17).
  referenceProfileId     String?
  /// Specific filename inside referenceProfileId's COMFY_OUTPUT to use as the
  /// reference. If not set, a deterministic middle image is auto-picked.
  referenceImageFilename String?
  comfyPromptId          String?
  errorMessage           String?
  queuedAt               DateTime  @default(now())
  startedAt              DateTime?
  completedAt            DateTime?

  profile CharacterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@index([status])
  @@map("dataset_jobs")
}

/// Renders the still image of ONE SHOT (the name is historical — there is no
/// sceneId here, the only FK is shotId). Queue ledger jobType 'scene' maps to
/// this table.
/// One Qwen-Image-Edit-2511 pass that turns a shot's approved still into the END
/// frame of its clip, for the two-frame (flf2v) video flow.
///
/// It is an EDIT of the start frame, never a fresh generation — the start frame
/// enters the graph as a reference and the instruction says only what changed.
/// Generating a last frame from text instead would produce a different face in a
/// similar room, and Wan would spend the whole clip morphing one person into
/// another: worse than the drift the two-frame flow exists to remove.
model EndFrameJob {
  id                  String    @id @default(uuid())
  shotId              String
  /// The START frame this was edited from — snapshot of `Shot.chosenRender` at
  /// enqueue time, so a later re-pick of the shot's still does not make it
  /// ambiguous which image the finished end frame actually continues from.
  sourceImageFilename String
  /// The instruction actually sent — snapshot of `Shot.endFramePrompt`, in the
  /// same spirit as `TTSJob.text`: editing the shot later never rewrites what a
  /// finished job did.
  instruction         String
  status              String // pending | running | completed | failed | cancelled
  comfyPromptId       String?
  params              Json?
  /// Basename written into `data/<project>/shots/<shotCode>/endframes/`.
  outputFilename      String?
  errorMessage        String?
  queuedAt            DateTime  @default(now())
  startedAt           DateTime?
  completedAt         DateTime?

  shot Shot @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@index([shotId])
  @@index([status, queuedAt])
  @@map("end_frame_jobs")
}

model SceneRenderJob {
  id            String    @id @default(uuid())
  shotId        String
  status        String // pending | running | completed | failed | cancelled
  /// ComfyUI prompt_id once dispatched; used to poll history for outputs.
  comfyPromptId String?
  /// Render parameters at enqueue time (seed, batchSize, scenePrompt override —
  /// despite the name that's the SHOT's positive prompt, …).
  /// Stored so the queue worker can rebuild the call after a backend restart.
  params        Json?
  errorMessage  String?
  queuedAt      DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  shot Shot @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@index([shotId])
  @@index([status, queuedAt])
  @@map("scene_render_jobs")
}

/// Image-validation jobs. After a shot's batch of candidate stills lands, a
/// local vision model (Ollama qwen3-vl) scores every current candidate against
/// what the shot is supposed to show and picks the best one — auto-setting
/// Shot.chosenRender. Runs in the same single-slot pipeline as every other GPU
/// job (PipelineQueueService.tick), but with the OPPOSITE engine arbitration to
/// ComfyUI jobs: dispatch stops ComfyUI first so the whole 16 GB card is free
/// for the vision model, and starting a ComfyUI job later unloads the model.
/// See ImageValidationService.
model ImageValidationJob {
  id              String    @id @default(uuid())
  shotId          String
  status          String    @default("pending") // pending | running | completed | failed
  /// What the frame is SUPPOSED to show — the resolved positive prompt captured
  /// from the render job — for the vision model to score the match against.
  expectedPrompt  String?
  /// The shot's narration (VO). VO↔image match is the strongest correctness
  /// signal (a frame must show exactly the subject the voiceover names).
  narration       String?
  /// Snapshot of the candidate filenames scored, in scoring order.
  candidates      Json?
  /// Full per-candidate result: [{filename, score, matchesPrompt, issues[]}].
  result          Json?
  /// Filename the model picked as best (also written to Shot.chosenRender).
  /// Null when NO candidate was acceptable (all severe / none matched) — in that
  /// case the shot's chosenRender is cleared and suggestedPrompt is filled.
  chosenFilename  String?
  /// When no candidate passed, the vision model's proposed improved positive
  /// prompt to fix the failures. The user reviews/edits/approves it in the UI,
  /// which writes it into Shot.promptFields.positive for the next render.
  /// LEGACY (flat positive-only) — new jobs write `suggestedFields` instead.
  suggestedPrompt String?
  /// Structured suggestion when no candidate passed:
  /// {"positive": full rewritten positive, "negative": tokens to APPEND to the
  /// shot's negative}. Each part goes into its own promptFields key on apply.
  suggestedFields Json?
  /// One-line justification from the comparative judge call (which candidate
  /// won and why) when >1 candidate passed QC.
  judgeReason     String?
  errorMessage    String?
  queuedAt        DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  shot Shot @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@index([shotId])
  @@index([status, queuedAt])
  @@map("image_validation_jobs")
}

/// Anchor-validation jobs — the character-portrait analogue of ImageValidationJob.
/// After an anchor render produces N candidate portraits, the Ollama vision model
/// scores each against the character's identity spec (promptBase) with a HARD
/// anti-anime rubric (this pipeline is western graphic-novel; anime = reject) and
/// picks the best clean single-subject portrait — copying it to the profile's
/// <profileCode>_anchor.png. If none is acceptable, no anchor is set and the model
/// proposes an improved promptBase for the user to edit/apply. Same single-slot
/// pipeline + ComfyUI-off arbitration as ImageValidationJob. See AnchorValidationService.
model AnchorValidationJob {
  id              String    @id @default(uuid())
  profileId       String
  status          String    @default("pending") // pending | running | completed | failed
  /// The character identity spec the portrait must depict — the profile's
  /// promptBase captured at enqueue (fed to the validator as REQUIRED content).
  expectedPrompt  String?
  /// Snapshot of the candidate anchor filenames scored, in scoring order. They
  /// live in data/<slug>/reference/_candidates/<profileCode>/.
  candidates      Json?
  /// Full per-candidate result: [{filename, score, matchesPrompt, severe, issues[]}].
  result          Json?
  /// Filename the model picked as best (copied to <profileCode>_anchor.png).
  /// Null when NO candidate was acceptable (all anime/severe / none matched) —
  /// no anchor is set and suggestedPrompt is filled.
  chosenFilename  String?
  /// When no candidate passed, the vision model's proposed improved promptBase.
  /// The user reviews/edits/approves it in the UI, which writes it into
  /// CharacterProfile.promptBase for the next anchor render.
  suggestedPrompt String?
  errorMessage    String?
  queuedAt        DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  profile CharacterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([status, queuedAt])
  @@map("anchor_validation_jobs")
}

// ─── Video renders ───────────────────────────────────────────────────────────
//
// Image-to-video renders driven by Wan2.2 i2v. One row per submitted job; the
// row holds the source image (the shot's approved render), the motion prompt,
// and the resulting mp4 filename once ComfyUI finishes.

model VideoRender {
  id                  String    @id @default(uuid())
  shotId              String
  /// Which image was used as the i2v starting frame. Stored as the basename
  /// inside `data/<project>/shots/<shotCode>/`.
  sourceImageFilename String
  /// Which image was pinned to the LAST frame, for a flf2v ("2 кадра") render.
  /// Basename inside `data/<project>/shots/<shotCode>/endframes/`. Null = this
  /// render used the one-frame i2v flow.
  ///
  /// Snapshot, not a live lookup: baked at enqueue time exactly like
  /// `params.panelShape` and `TTSJob.engine`, so re-approving a different end
  /// frame later never silently changes what an already-queued clip renders.
  endImageFilename    String?
  /// Motion prompt — what should the animated frame do (camera move, subject
  /// movement, etc.). Concatenated into the Wan2.2 positive prompt.
  motionPrompt        String
  /// Lifecycle: pending → running → completed | failed | cancelled.
  status              String
  /// ComfyUI prompt_id once dispatched; used to poll history.
  comfyPromptId       String?
  /// Render parameters at enqueue time (seed, length, fps, width, height, etc.)
  params              Json?
  /// Basename of the output mp4 in `data/<project>/shots/<shotCode>/videos/`.
  outputFilename      String?
  /// Workflow filename used (e.g. "video_wan22_i2v_api.json").
  workflowFilename    String
  errorMessage        String?
  queuedAt            DateTime  @default(now())
  startedAt           DateTime?
  completedAt         DateTime?

  /// Upscale-on-demand (4x-UltraSharp → 1920×1080). Null until user clicks
  /// "upscale" on a completed video. Lifecycle mirrors the main status field.
  upscaleStatus       String?
  upscaledFilename    String?
  upscalePromptId     String?
  /// When this row's upscale lifecycle entered `pending`. Distinct from the
  /// main render's `queuedAt` because an upscale is requested some time after
  /// the underlying video finishes — sorting upscales by `queuedAt` would
  /// place every new upscale ahead of newly-queued renders.
  upscaleQueuedAt     DateTime?
  upscaleStartedAt    DateTime?
  upscaleCompletedAt  DateTime?
  upscaleErrorMessage String?

  /// FPS interpolation (RIFE/FILM → 2× framerate). MANDATORY final step before
  /// CapCut export. Null until the user queues it; can only be queued once the
  /// upscale has completed (it interpolates the FHD output). Lifecycle mirrors
  /// the upscale fields above: null → pending → running → completed | failed.
  interpStatus       String?
  /// Basename of the smoothed mp4 in `data/<project>/shots/<shotCode>/videos_smooth/`.
  interpFilename     String?
  interpPromptId     String?
  /// Frame multiplier used (2 = double FPS). Snapshot at enqueue time.
  /// Drop this clip's own audio on export. LTX-2.5 writes sound into the clip
  /// (footsteps, a lock, breath) and sometimes invents a music bed that fights
  /// the act's ACE-Step score — this is the per-clip off switch. The file keeps
  /// its audio; the CapCut segment is laid with volume=0, so it is reversible.
  /// Meaningless for Wan clips, which carry no audio at all.
  audioMuted         Boolean  @default(false)
  interpMultiplier   Int?
  /// When this row's interpolation lifecycle entered `pending` — FIFO key,
  /// distinct from queuedAt/upscaleQueuedAt for the same reason upscale needs its own.
  interpQueuedAt     DateTime?
  interpStartedAt    DateTime?
  interpCompletedAt  DateTime?
  interpErrorMessage String?

  shot      Shot            @relation(fields: [shotId], references: [id], onDelete: Cascade)
  qcVerdict VideoQcVerdict?

  @@index([shotId])
  @@index([status, queuedAt])
  @@index([upscaleStatus, upscaleQueuedAt])
  @@index([interpStatus, interpQueuedAt])
  @@map("video_renders")
}

// ─── Video QC (клипы) ────────────────────────────────────────────────────────
//
// Same architecture as Image QC / VO QC: ONE queue job per project run over
// every completed i2v BASE clip (videos/, pre-upscale). Layer A = deterministic
// scanner (scripts/video_qc_batch.py: frame-diff motion energy, skin-hue drift
// vs the source still, DWPose anatomy on the last sample, new-face detection,
// cut spikes, identity drift) — layer B = anchored Qwen-VL classification of
// the suspicious frames layer A extracted (аниме-пришелец). Advisory only: no
// gate, никогда не трогает chosenVideoId. Verdict is 1:1 to a VideoRender row
// via FK CASCADE — deleting the clip deletes the verdict; a re-render is a new
// row and simply has no verdict yet.

model VideoQcRun {
  id              String    @id @default(uuid())
  projectId       String
  status          String    @default("pending") // pending | running | completed | failed | cancelled
  /// 'full'|'incremental' — every completed clip without a verdict.
  /// 'spot' — every clip of shotIdsOverride, verdicts overwritten.
  mode            String
  shotIdsOverride Json?
  totalClips      Int       @default(0)
  processedClips  Int       @default(0)
  lastProgressAt  DateTime?
  /// Rollup on completion: {pass, warn, fail, error, skippedMissingFile}.
  summary         Json?
  errorMessage    String?
  queuedAt        DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verdicts VideoQcVerdict[]

  @@index([projectId, status])
  @@index([status, queuedAt])
  @@map("video_qc_runs")
}

model VideoQcVerdict {
  id            String @id @default(uuid())
  videoRenderId String @unique
  /// Which run last (re)computed this verdict — audit only.
  runId         String

  /// 'pass' — глазами не смотреть. 'warn' — advisory (рывок, дрейф, новое лицо
  /// без аниме). 'fail' — статичный клип, синие лица, расплав анатомии,
  /// аниме-пришелец. 'error' — файл пропал / воркер упал.
  status String

  /// 'static_clip' | 'skin_hue_drift' | 'anatomy_melt' | 'two_heads_one_body' |
  /// 'new_subject_mid_clip' | 'cut_spike' | 'identity_drift' | 'fused_bodies' |
  /// 'anime_intruder' | 'style_drift' | 'vlm_uncertain' | informational flags
  flags Json? // string[]
  /// Raw numbers for threshold calibration: {motionEnergy, maxCutSpike,
  /// hueDriftDeg, blueFraction, identityDist, samples:[{t, people, faces}]}
  metrics Json?
  /// Suspicious moments layer A flagged: [{timeSec, reason}]
  suspicious Json?
  /// Layer B (anchored Qwen-VL) exchange per suspicious frame.
  vlmAnswers Json?
  /// Flattened human-readable strings (Russian), one per finding.
  issues Json? // string[]

  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  run         VideoQcRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  videoRender VideoRender @relation(fields: [videoRenderId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
  @@map("video_qc_verdicts")
}

model TrainingJob {
  id             String    @id @default(uuid())
  profileId      String
  status         String // pending | preparing | captioning | training | completed | failed
  baseModel      String
  triggerToken   String?
  datasetPath    String?
  configPath     String?
  outputLoraPath String?
  logPath        String?
  errorMessage   String?
  progress       Json? // { phase, current, total, ... }
  /// Effective queue ordering timestamp. Mirrors DatasetJob.queuedAt so the
  /// pipeline queue can order both job types by one field. Defaults to now()
  /// at row creation; gets swapped when the user reorders the queue in UI.
  queuedAt       DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile CharacterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@index([status, queuedAt])
  @@map("training_jobs")
}

// ─── TTS (Silero V5 ru) ──────────────────────────────────────────────────────
//
// One row per "synthesise this scene's narration" request. Runs on CPU via a
// Python subprocess (scripts/tts_silero.py). Dispatched through the unified
// PipelineQueueService FIFO — same single-slot serialisation as GPU work, so
// rendering a TTS doesn't race with a scene/video render and vice versa.

model TTSJob {
  id               String    @id @default(uuid())
  /// Owner: either a Scene or a Shot, never both. Scene-level (legacy) =
  /// single long voiceover per scene saved to data/<slug>/scenes/<sceneKey>/.
  /// Shot-level (current default for night_courier-style projects) = one ~5s
  /// voiceover per shot saved to data/<slug>/shots/<shotCode>/. A row with
  /// both null is a bug; service code enforces exactly-one-of.
  sceneId          String?
  shotId           String?
  /// Engine snapshot at enqueue time. 'silero' = Silero V5 ru worker;
  /// 'xtts2' = XTTS-v2 voice-clone worker; 'f5' = F5-TTS Russian voice-clone
  /// worker. Null = legacy rows pre-dating the field; treat as 'silero'.
  engine           String?
  /// Text snapshot at enqueue time. Editing narration text later does NOT
  /// retroactively change rendered audio — re-queue to regenerate.
  text             String
  /// Silero speaker id (silero engine only). V5 voices: aidar | baya |
  /// kseniya | xenia | eugene. V3/V4 add: ruslan | random.
  /// Ignored by the voice-clone engines (xtts2 / f5).
  voice            String
  /// Which .pt model file under .silero_cache/ was used. Null = auto-pick by
  /// MODEL_FILENAMES precedence (V5_5 wins). Example: "v3_1_ru.pt", "v4_ru.pt".
  modelFilename    String?
  /// Emotion preset, one of: neutral | happy | sad | angry | fear | disgust |
  /// surprise | calm. Null = neutral. INERT today: both voice-clone engines
  /// (xtts2, f5) ignore the categorical preset — tone comes from the speaker
  /// clip. Kept as a snapshot/allow-list for a future categorical engine.
  emotionPreset    String?
  /// Emotion intensity [0.0–1.0]. Null = 0.5. INERT today (see emotionPreset).
  emotionIntensity Float?
  /// User-uploaded emotion reference name (matches ProjectTTSEmotionRef.name).
  /// This is the knob that actually changes tone on xtts2/f5 (swaps the speaker
  /// clip for the render). Overrides emotionPreset. Ignored for silero.
  emotionRefName   String?
  /// Output sample rate: 8000 | 24000 | 48000 (Silero supports these three).
  sampleRate       Int
  /// Playback rate (1.0 = normal, <1 slower, >1 faster). Applied via
  /// post-synthesis waveform resampling in the Python worker — Silero
  /// TTSModelMultiAcc_v3 (v5) doesn't expose `apply_ssml`.
  rate             Float     @default(1.0)
  /// Extra silence to insert after every sentence boundary (in seconds).
  /// 0 = no extra pause; documentary narration commonly uses 3-5s so the
  /// editor can drop B-roll between beats. The Python worker splits on
  /// [.!?…]+, synthesises each chunk separately, then concatenates with
  /// `silence = zeros(int(sr * pause_sec))` between.
  sentencePauseSec Float     @default(0)
  status           String // pending | running | completed | failed | cancelled
  /// Basename of the wav. Scene-level jobs live in
  /// data/<slug>/scenes/<sceneKey>/, shot-level jobs in
  /// data/<slug>/shots/<shotCode>/.
  outputFilename   String?
  /// Actual wav duration in milliseconds — probed from the RIFF header on
  /// completion (or backfilled when an older row is first read by the scenes
  /// endpoint). Null = not yet measured; UI falls back to the text-length
  /// heuristic (text.length / 15 cps) until populated.
  durationMs       Int?
  errorMessage     String?
  queuedAt         DateTime  @default(now())
  startedAt        DateTime?
  completedAt      DateTime?

  scene Scene? @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shot  Shot?  @relation(fields: [shotId], references: [id], onDelete: Cascade)
  /// Current VO-QC verdict for this job's wav (1:1, upserted in place). Null =
  /// never validated, or invalidated because the wav's bytes changed
  /// (trimArtifact / revertArtifact delete the verdict row).
  voVerdict VoValidationVerdict?

  @@index([sceneId])
  @@index([shotId])
  @@index([status, queuedAt])
  @@map("tts_jobs")
}

// ─── VO validation (audio QC of rendered narration) ──────────────────────────
//
// One VoValidationRun row per "проверить озвучку проекта" click — a single
// queue job (jobType 'vo_validation', engineClass 'whisper' → ComfyUI stopped)
// that drives ONE faster-whisper batch process + ONE prosody batch process over
// every wav due for checking, so each heavy runtime loads exactly once per run,
// not once per shot. Verdicts stream in as NDJSON lines and are upserted onto
// vo_validation_verdicts IMMEDIATELY per line — a killed run loses nothing, and
// the next run's "no verdict yet" selection naturally resumes where it stopped.

model VoValidationRun {
  id             String    @id @default(uuid())
  projectId      String
  status         String    @default("pending") // pending | running | completed | failed | cancelled
  /// 'full' = first-ever run for the project — validates EVERY completed TTSJob.
  /// 'incremental' = re-run — only jobs without a verdict on shots/scenes
  ///                 without an approved take.
  /// 'spot' = explicit re-check of specific jobs (jobIdsOverride), e.g. after a
  ///          trim invalidated the verdict of an already-approved take.
  mode           String
  /// Explicit TTSJob ids for mode='spot'. Null otherwise — full/incremental
  /// recompute their job set at dispatch time, so a run queued behind other work
  /// still picks up TTS jobs that completed meanwhile.
  jobIdsOverride Json?
  totalJobs      Int       @default(0)
  processedJobs  Int       @default(0)
  /// Bumped every time a verdict is persisted — live-progress signal for the
  /// UI. Runaway protection itself is the per-stage hard timeout inside
  /// VoValidationService.streamWorker (scaled to the batch size), not a
  /// queue-level watcher.
  lastProgressAt DateTime?
  /// Rollup written on completion: {pass, warn, fail, error, skippedMissingFile}.
  summary        Json?
  errorMessage   String?
  queuedAt       DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  project  Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verdicts VoValidationVerdict[]

  @@index([projectId, status])
  @@index([status, queuedAt])
  @@map("vo_validation_runs")
}

/// Current QC verdict for ONE TTSJob's wav — 1:1, upserted in place (never
/// appended): the wav is a single immutable artifact, so there is exactly one
/// true verdict for it at any time. Invalidated (deleted) by
/// TTSService.trimArtifact/revertArtifact because those mutate the wav's bytes.
/// A re-rendered take is a NEW TTSJob row, so stale verdicts cannot occur there.
model VoValidationVerdict {
  id       String @id @default(uuid())
  ttsJobId String @unique
  /// Which run last (re)computed this verdict — audit only.
  runId    String

  /// 'pass' — clean, no manual listening needed.
  /// 'warn' — advisory findings (number mismatch, prosody heuristic) — listen.
  /// 'fail' — word integrity broken (dropped/repeated/garbled words) — listen.
  /// 'error' — could not be scored (missing file, ASR failure) — listen.
  /// Per user 2026-08-03: manual review is ONLY for non-pass verdicts, so
  /// riskyStressWords deliberately do NOT affect status (omographs are near-
  /// universal in Russian text and would flag every shot).
  status String
  /// 0-100 composite, sorting/triage aid only — never gates anything.
  score  Int?

  // ── word integrity: TTSJob.text (frozen snapshot) vs whisper transcript ──
  transcript    String?
  wer           Float?
  missingWords  Json? // string[]
  extraWords    Json? // string[]
  repeatedWords Json? // string[] — TTS stutter (consecutive duplicate not in text)
  garbledWords  Json? // [{expected, heard}] aligned substitutions

  /// Homographs/ambiguous-stress words present in the text (RUAccent
  /// omographs.json.gz lookup). Advisory context on flagged jobs + a report
  /// column; NEVER affects status (see above).
  riskyStressWords Json? // string[]

  /// 'monotone' | 'too_fast' | 'too_slow' | 'long_mid_silence' | 'clipping'
  prosodyFlags Json? // string[]
  /// 'truncated_end' | 'leading_garbage' | 'too_short' | 'too_long'
  techFlags    Json? // string[]

  /// Flattened human-readable strings (Russian), one per finding — built once
  /// at persist time so the UI never re-derives prose from the fields above.
  issues Json? // string[]

  /// TTSJob.text (frozen at render time) no longer matches the shot's CURRENT
  /// narrationText — the audio may not say what the script now says.
  textSnapshotStale Boolean @default(false)

  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  run    VoValidationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  ttsJob TTSJob          @relation(fields: [ttsJobId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
  @@map("vo_validation_verdicts")
}

// ─── Image QC (кадры) ────────────────────────────────────────────────────────
//
// Deterministic-first QC of rendered shot candidates — the successor of the
// retired LLM-judge ImageValidationJob flow (2026-08-07). Mirrors VO QC: ONE
// queue job per project run drives ONE pose batch process (DWPose skeletons +
// scrfd faces, no ComfyUI server) over every candidate due for checking, then a
// targeted Qwen fact-checklist pass for shots with a key prop. Verdicts stream
// in as NDJSON and are upserted per line — a killed run loses nothing. The QC
// never chooses a frame (no chosenRender writes): pass = не смотреть глазами,
// everything else lands in the worklist.

model ImageQcRun {
  id              String    @id @default(uuid())
  projectId       String
  status          String    @default("pending") // pending | running | completed | failed | cancelled
  /// 'full' = first-ever run — every candidate without a verdict.
  /// 'incremental' = re-run — only candidates without a verdict.
  /// 'spot' = explicit re-check of specific shots (shotIdsOverride), verdicts
  ///          overwritten.
  mode            String
  shotIdsOverride Json?
  totalImages     Int       @default(0)
  processedImages Int       @default(0)
  /// Bumped on every persisted verdict — live-progress signal for the UI.
  lastProgressAt  DateTime?
  /// Rollup on completion: {pass, warn, fail, error, skippedMissingFile}.
  summary         Json?
  errorMessage    String?
  queuedAt        DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verdicts ImageQcVerdict[]

  @@index([projectId, status])
  @@index([status, queuedAt])
  @@map("image_qc_runs")
}

/// Current QC verdict for ONE candidate file of a shot — unique on
/// (shotId, filename), upserted in place. A rendered PNG is immutable, so there
/// is exactly one true verdict per file; deleting the file's verdict row is the
/// invalidation path (renders are never edited in place — a re-render appends a
/// NEW filename).
model ImageQcVerdict {
  id       String @id @default(uuid())
  shotId   String
  filename String
  /// Which run last (re)computed this verdict — audit only.
  runId    String

  /// 'pass'  — clean by every layer that could judge it; не смотреть глазами.
  /// 'warn'  — advisory: people-count mismatch, крупное бесхозное лицо,
  ///           uncertain fact-check — look when convenient.
  /// 'fail'  — deterministic defect: карликовые пропорции взрослого, two faces
  ///           on one skeleton, prop fact-check contradiction — must review.
  /// 'error' — could not be scored (file missing, worker exception).
  status String

  /// ShotParticipant rows at scoring time (expected people in frame).
  peopleExpected  Int?
  /// Skeletons the pose detector found (foreground-scale; background excluded).
  peopleFound     Int?
  /// Faces classified as background (much smaller than the primary face) —
  /// informational only, never affects status.
  backgroundFaces Int?

  /// Deterministic layer findings:
  /// 'dwarf_proportions' | 'two_heads_one_body' | 'extra_person' |
  /// 'missing_person' | 'fused_bodies' | 'no_full_body' (informational)
  poseFlags Json? // string[]
  /// Per-person metrics for triage/threshold calibration:
  /// [{headHeightRatio, fullBodyVisible, kpConfidence, isChildExpected}]
  poseMetrics Json?
  /// Qwen fact-checklist findings: 'prop_mismatch' | 'prop_uncertain'
  factFlags Json? // string[]
  /// Raw fact-check exchange for the UI:
  /// {objectSeen, isPartOf, locationInFrame, matchesExpected, reason}
  factAnswers Json?

  /// Flattened human-readable strings (Russian), one per finding.
  issues Json? // string[]

  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  run  ImageQcRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  shot Shot       @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@unique([shotId, filename])
  @@index([runId])
  @@index([status])
  @@map("image_qc_verdicts")
}

// ─── Voice-clone emotion references (per-project library) ────────────────────
//
// Each project on a voice-clone engine (xtts2 / f5) has one voice reference
// (Project.ttsVoiceRefPath) that defines WHO speaks, plus an arbitrary number
// of named "emotion references" — short clips (~3–8s) of someone speaking
// with the target prosody (tired, anxious, whispering, …). A shot's TTS job
// can pick one by name; the worker uses it AS the speaker clip for that render
// (these engines have no separate emotion path). Optional.

model ProjectTTSEmotionRef {
  id        String   @id @default(uuid())
  projectId String
  /// User-defined identifier, unique per project. Lowercase ASCII recommended
  /// (e.g. "tired", "exhausted", "whisper"). Picked from a dropdown / typed
  /// into autocomplete on the shot narration UI.
  name      String
  /// Project-relative wav path. Convention:
  /// data/<slug>/tts/emotion_refs/<name>.wav.
  filePath  String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@map("project_tts_emotion_refs")
}

// ─── Voiceovers (закадровая озвучка — shared reusable voice library) ──────────
//
// A Voiceover is ONE voice-clone reference clip stored once in a shared library
// (data/_voices/<slug>/voice_reference.<ext>) and assigned to any number of
// projects via Project.ttsVoiceoverId — instead of uploading a copy into every
// project's data/<slug>/tts/. `checksum` (md5 of the bytes) is unique so two
// identical uploads collapse into one row. Assigning mirrors the shared path
// into Project.ttsVoiceRefPath, which the render/gating code already reads.

model Voiceover {
  id             String   @id @default(uuid())
  /// Stable kebab/snake identifier, unique across the library, ASCII only.
  /// e.g. "cat_lady" or "female-tired". Used in the data/_voices/<slug>/ path.
  slug           String   @unique
  /// Human-friendly label for the UI dropdown. Russian is fine — never sent to TTS.
  name           String
  /// App-relative path to the single clip: data/_voices/<slug>/voice_reference.<ext>.
  filePath       String
  /// File extension including the dot (".wav", ".mp3", …).
  ext            String
  /// Byte size on disk (shown in the UI; informational).
  bytes          Int
  /// MD5 hex of the file bytes — unique, dedupes identical uploads into one row.
  checksum       String   @unique
  /// Optional provenance link — the YouTube (or any) URL the reference clip was
  /// taken from, so the original source can be re-found. Null = unknown source.
  sourceUrl      String?
  /// App-relative path to the FULL, untrimmed source clip kept alongside the
  /// reference (data/_voices/<slug>/source.<ext>) so the clip can be re-trimmed
  /// later without re-downloading. Null = imported before this feature / no
  /// source retained (a plain legacy upload). The rendered `filePath` clip is
  /// always the trimmed WAV the engines consume; this is only for re-editing.
  sourceFilePath String?
  /// Trim window (milliseconds into `sourceFilePath`) that produced the current
  /// `filePath` clip. Both null = clip is the whole source / no trim recorded.
  /// Persisted so the trim UI can reopen at the last selection and re-cut.
  trimStartMs    Int?
  trimEndMs      Int?
  /// Which leading-bleed detection profile in scripts/trim_lead_artifact.py this
  /// voice needs, or NULL when it needs none — and NULL is the norm.
  ///
  /// F5 prepends a short burst to every render for SOME voices only. Measured
  /// 2026-08-03 over 14 sampled renders of each voice/engine pair: «Кошатница»
  /// 14/14 (profile "pon", a loud burst) and «агента Смита» 13/14 (profile
  /// "sha", a quiet one that needs the envelope method). Every other voice —
  /// beauty, bio_plus, flat_earth, honeywagon, message, tiler, voice, voice-2,
  /// voice-4, voice-5, wall, plus all qwen3/xtts2 renders — came back 0/14.
  ///
  /// This is a property of the VOICE, so the trimmer must be OFF unless a voice
  /// opts in here: on a clean voice the detector's own shape ("quiet blob, then
  /// a gap") fits a quiet leading preposition, and it would eat the word. That
  /// is not hypothetical — sampling engineer/layoff/A3_SH55 and voice-5/trucker/
  /// A8_SH03 it wanted to cut a real «В».
  artifactProfile String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Projects that have this voice assigned (Project.ttsVoiceoverId).
  projects Project[]

  @@map("voiceovers")
}

// ─── BGM (ACE-Step v1.5 background music) ────────────────────────────────────
//
// Narrative-block-driven background music. A project is split into a small
// number of NarrativeBlocks ("Старт", "Рост", "Выгорание", …) whose target
// duration equals the sum of the shots they cover. Each block is auto-filled
// with one or more MusicSegment rows (30–90s typical, ACE-Step ceiling ~4 min)
// until total segment duration meets the block's target. Each segment owns its
// AudioRenderJob history (status + comfyPromptId + flac on disk), same lifecycle
// as VideoRender. All ACE-Step jobs go through PipelineQueueService — single-slot
// FIFO with image/video/training so the GPU never gets two music jobs at once.
//
// All English prompts/tags in DB content — Russian breaks ACE-Step tokenizer
// the same way it breaks CLIP for SDXL.

model NarrativeBlock {
  id            String   @id @default(uuid())
  projectId     String
  /// Stable identifier for the block within the project. English. e.g. "start",
  /// "growth", "burnout". Used in filesystem paths data/<slug>/bgm/<blockSlug>/.
  slug          String
  /// Human-friendly title for the UI. Russian is fine here — never sent to ACE.
  title         String?
  sortOrder     Int      @default(0)
  /// Default ACE-Step tag prompt inherited by every segment unless overridden.
  /// English comma-separated tags (e.g. "cinematic, warm, hopeful, piano").
  moodPrompt    String?
  /// ACE-Step 1.5 metadata conditioning for this act. These are NOT decoration:
  /// `TextEncodeAceStepAudio1.5` renders them into the model prompt as a labelled
  /// `# Metas` block (see comfy/text_encoders/ace15.py `_metas_to_cap`), so a
  /// caption that states its own tempo/key CONTRADICTS them and the beat comes
  /// out belonging to neither. Tempo and key live here; moodPrompt stays prose.
  /// Null = leave the workflow template's own value (120 / A minor / 4) alone.
  /// Valid ranges are enforced in bgm.types.ts — an invalid keyscale is a hard
  /// ComfyUI validation error, not a soft fallback. See Skill(gen-studio-acestep).
  bpm           Int?
  /// "<Root> <quality>", quality lowercase: "A minor", "Eb major". NOT "Am".
  keyscale      String?
  /// Bare digit, one of '2' '3' '4' '6'. NOT "4/4".
  timesignature String?
  /// ACE-Step section markers for the `lyrics` input — the act's temporal
  /// script, e.g. "[intro - ambient]" / "[main theme - felt piano]" /
  /// "[outro - fade out]", one marker per line. Null = generate the arc from
  /// moodPrompt per tile (buildLyricsArc). Markers only: free lyric text
  /// against a "no vocals" caption produces wordless vocalisations.
  /// See Skill(gen-studio-acestep) §4.
  lyricsStructure String?
  /// Ordered array of Shot.id strings this block covers. Source of truth for
  /// `targetSeconds` — kept as JSON instead of a join table because order matters
  /// and the block's "shape" is rarely edited (set once during script breakdown).
  shotIds       Json
  /// Cached sum of shot durations in seconds. Recomputed when shotIds changes
  /// or shot videos are re-rendered with new lengths.
  targetSeconds Int?
  /// Lifecycle: filling (auto-fill loop active) | filled (sum(segments) >=
  /// targetSeconds, idle) | manual (user took over, no auto-fill).
  status        String   @default("filling")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  segments MusicSegment[]

  @@unique([projectId, slug])
  @@index([projectId, sortOrder])
  @@map("narrative_blocks")
}

model MusicSegment {
  id            String   @id @default(uuid())
  blockId       String
  sortOrder     Int      @default(0)
  /// Override of block.moodPrompt for this segment. English ACE-Step tags. Null
  /// = use block default. Lets an arc inside one block ("warm → tense → release").
  prompt        String?
  /// Per-tile override of the block's ACE-Step metas. Null = inherit the block's
  /// value (which in turn may be null = keep the template default). Same
  /// validation rules as NarrativeBlock — see Skill(gen-studio-acestep) §2.
  bpm           Int?
  keyscale      String?
  timesignature String?
  /// Per-tile override of the block's lyrics section arc. Null = inherit the
  /// block's, which in turn null = generated from the caption.
  lyricsStructure String?
  /// Target seconds for this segment. Final flac length is decided by ACE-Step
  /// (driven by node `EmptyAceStep1.5LatentAudio.seconds`); this is the request.
  durationSec   Int      @default(60)
  /// Spare tile: generated on the act mood prompt but laid raw (no fade / no
  /// crop) on its own export lane, as manual-editing material. false = a main
  /// tile that the exporter places checkerboard with a crossfade.
  spare         Boolean  @default(false)
  /// AudioRenderJob.id chosen as the canonical take for this segment. Plain id,
  /// no FK — mirrors approvedTTSJobId convention, so deleting a job row doesn't
  /// cascade-null the segment.
  approvedJobId String?
  createdAt     DateTime @default(now())

  block NarrativeBlock   @relation(fields: [blockId], references: [id], onDelete: Cascade)
  jobs  AudioRenderJob[]

  @@index([blockId, sortOrder])
  @@map("music_segments")
}

model AudioRenderJob {
  id               String    @id @default(uuid())
  segmentId        String
  status           String // pending | running | completed | failed | cancelled
  /// ComfyUI prompt_id once dispatched.
  comfyPromptId    String?
  /// Render parameters at enqueue time: { seed, steps, cfg, samplerName,
  /// scheduler, durationSec, prompt }. Snapshotted so the worker can rebuild
  /// the workflow after a backend restart.
  params           Json?
  /// Workflow filename used (under data/<slug>/comfy/). Default points at
  /// the ACE-Step text-to-audio template.
  workflowFilename String    @default("bgm_acestep_api.json")
  /// Basename of the rendered flac in data/<slug>/bgm/<blockSlug>/.
  outputFilename   String?
  errorMessage     String?
  queuedAt         DateTime  @default(now())
  startedAt        DateTime?
  completedAt      DateTime?

  segment MusicSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([segmentId])
  @@index([status, queuedAt])
  @@map("audio_render_jobs")
}

/// Anchor portrait render jobs. Cartoon-style identity is locked via IP-Adapter
/// on a single anchor PNG per character profile. This table tracks the queue
/// of "render an anchor for this profile via ComfyUI" jobs the same way
/// scene_render_jobs tracks shot renders. PipelineQueueService.tick() dispatches
/// pending rows one at a time. See AnchorRenderService.
model AnchorRenderJob {
  id            String    @id @default(uuid())
  profileId     String
  status        String    @default("pending")
  /// ComfyUI prompt_id once dispatched. Null until status moves from pending → running.
  comfyPromptId String?
  /// Absolute on-disk path of the saved anchor PNG once completed.
  outputPath    String?
  errorMessage  String?
  queuedAt      DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  profile CharacterProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([status, queuedAt])
  @@map("anchor_render_jobs")
}

/// YouTube thumbnail jobs — render the cover ART for a project, with NO text in
/// it, then draw the clickbait caption on top from a font file.
///
/// The split is deliberate (user decision 2026-07-27). A diffusion model has no
/// channel for typography: no coordinates, no font size, no per-word colour, so
/// asking it to write the caption made placement and the red accent word a
/// lottery — proven over eight Qwen-Image-Edit test renders. `captionSpec` is
/// consumed by `scripts/render_caption.py`, which is deterministic, needs no
/// GPU, and can therefore be re-run over the same art as many times as the
/// operator wants to reword the hook.
///
/// Stage 2 of the thumbnail pipeline: the local text model reads the screenplay
/// and invents cover concepts. Queued like every other GPU job — Ollama needs
/// the whole card, so the dispatcher stops ComfyUI before running it (engine
/// class `ollama`), instead of the job fighting a render for VRAM.
///
/// The result is a REVIEW LIST, not work: the operator reads the concepts and
/// queues only the ones worth rendering, as ThumbnailJob rows.
model ThumbnailIdeaJob {
  id           String    @id @default(uuid())
  projectId    String
  /// How many distinct concepts to ask for.
  count        Int       @default(6)
  status       String    @default("pending")
  /// The proposed concepts once generated: [{ idea, prompt, refProfileCode,
  /// captionSpec }]. Kept even after they are queued, as a record of what the
  /// model actually suggested.
  result       Json?
  errorMessage String?
  queuedAt     DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status, queuedAt])
  @@map("thumbnail_idea_jobs")
}

/// Only the ART half is queued work; the caption pass runs outside the queue.
///
/// ONE ROW = ONE IDEA, rendered as a batch of candidates. A project accumulates
/// many rows: the operator asks for a fresh set of concepts, queues them, tops
/// the pool up later ("догенерировать"), and finally picks a single winning
/// frame out of everything on the table — so the pool is deliberately additive
/// and nothing is overwritten by the next round.
model ThumbnailJob {
  id               String    @id @default(uuid())
  projectId        String
  status           String    @default("pending")
  /// Short human label of the concept ("птица в золотой клетке"), so a wall of
  /// candidates stays readable in the picker.
  idea             String?
  /// Natural-language art prompt. NEVER asks for lettering (see the skill §5.6).
  prompt           String
  negative         String?
  /// Candidates to render for THIS idea. Several ideas × several candidates is
  /// how the pool reaches double digits.
  batchSize        Int       @default(2)
  /// Filenames of the rendered candidates, relative to `artPath`.
  candidates       Json?
  /// Set on the ONE job across the whole project whose candidate the operator
  /// chose; holds that candidate's filename. Picking a new winner clears it
  /// everywhere else, so "the chosen cover" is always a single row.
  chosenFilename   String?
  /// Keep the anchor's PIXEL channel (`reference_latents`) as well as the VL
  /// one. On = likeness holds; off = only "who this person is" semantics travel
  /// and the composition is free. Null = the service default. Per-idea because
  /// it is the single biggest lever on a cover and worth A/B-ing.
  referenceLatents Boolean?
  /// Whose anchors are attached as identity references, in Picture-N order —
  /// `image1..image3` on the encode nodes, which is the graph's hard limit.
  ///
  /// The local model chooses these per concept: which age profile the moment
  /// calls for (VIKA_YOUNG for the arrival, VIKA_OLD for the reckoning), and
  /// whether a second person belongs in frame. Codes only, always from THIS
  /// project's cast — anchors from other films are deliberately out of scope,
  /// since on non-Qwen projects the first reference also carries the style.
  refProfileCodes  String[]
  /// Sampling tier for this render: 'scene' | 'balanced' | 'full'.
  ///
  /// The cover chain normally drops the Lightning speed LoRA and runs real steps
  /// at cfg 3.0, which costs ~13× a scene frame — deliberate, since cfg > 1 is
  /// what keeps a cover from reading grey and flat. That is not always worth the
  /// wait, so the operator can pick: 'scene' reproduces the ordinary shot regime
  /// (Lightning, 4 steps, cfg 1.0), 'balanced' is the middle, 'full' is the
  /// original. Null = the service default, so every existing row keeps rendering
  /// exactly as it did.
  quality          String?
  /// Caption parameters for the overlay pass: lines, accent_word, accent_color,
  /// position, align, width_pct, font. Shape documented in render_caption.py.
  captionSpec      Json?
  /// ComfyUI prompt_id once dispatched. Null until pending → running.
  comfyPromptId    String?
  /// Directory of the rendered text-free art candidates.
  artPath          String?
  /// The finished cover (art + caption) once the overlay pass has run.
  outputPath       String?
  errorMessage     String?
  queuedAt         DateTime  @default(now())
  startedAt        DateTime?
  completedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status, queuedAt])
  @@map("thumbnail_jobs")
}

/// Subtitle/caption jobs — transcribe a project's FINAL exported mp4 with
/// faster-whisper (in the qwen3 venv) into an .srt, then upload it to the video
/// on YouTube via captions.insert. Runs through PipelineQueueService in the same
/// single GPU slot as every other job (whisper is CPU, but the queue is
/// single-slot by invariant, so a transcription pauses renders until it's done).
/// See YoutubeCaptionsService.
model CaptionJob {
  id           String    @id @default(uuid())
  projectId    String
  /// The YouTube video id to attach the caption track to (from the upload).
  videoId      String
  /// Absolute path to the mp4 to transcribe (the final CapCut export).
  videoPath    String
  /// BCP-47 language of the caption track.
  language     String    @default("ru")
  status       String    @default("pending") // pending | running | completed | failed
  /// Path to the generated .srt once transcription completes.
  srtPath      String?
  /// True once captions.insert accepted the track.
  uploaded     Boolean   @default(false)
  errorMessage String?
  queuedAt     DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  @@index([status, queuedAt])
  @@map("caption_jobs")
}

// ─── Unified queue + render ledger ───────────────────────────────────────────
//
// ONE row per attempt at ONE unit of GPU/pipeline work, for every job type.
// It is simultaneously:
//   (a) the queue — `pending` rows ordered by (project tier, rank) are what the
//       dispatcher picks from, so "position in the queue" is a real column and
//       never a mutated timestamp again;
//   (b) the permanent history — a row goes terminal and is then NEVER updated,
//       NEVER deleted. Terminal rows accumulate and ARE the render history.
//
// It does NOT replace the per-type job tables (scene_render_jobs, video_renders,
// tts_jobs, …). Those keep holding live ComfyUI polling state (promptId, params,
// output filenames) and stay the "current state" layer. This table owns ordering
// and history only, which is why it can be added additively.
//
// Deliberately FK-free: every upstream reference is a plain string id plus a
// denormalized snapshot, exactly like the existing Shot.chosenVideoId /
// Shot.approvedTTSJobId / MusicSegment.approvedJobId convention. A cascade
// delete of a shot, scene, project or profile therefore CANNOT reach this table
// — which is the whole point: the time spent on a deleted shot is still time
// spent on the film.

model QueueEntry {
  id String @id @default(uuid())

  /// training | dataset | scene | video | video_post | tts | bgm | anchor
  /// | validation | anchor_validation | caption
  ///
  /// `video_post` is the combined one-pass upscale→RIFE job: ONE ComfyUI prompt
  /// produces both the FHD and the smooth clip. There is deliberately no
  /// separate `video_interp` type — the two-prompt split was a rudiment of the
  /// pre-2026-07-21 two-step path.
  jobType       String
  /// Id of the row in the type-specific table this entry drives. NOT an FK.
  /// For `video` and `video_post` this is the same VideoRender.id — the two
  /// lifecycles on that row are two entries distinguished by jobType.
  jobId         String
  /// 1-based attempt counter within (jobType, jobId). Only ever exceeds 1 where
  /// the source row is REUSED across retries (video_post resets its upscale*
  /// fields on re-run) — the earlier attempt survives here as its own row even
  /// though the source row no longer remembers it.
  attemptNumber Int    @default(1)

  status String @default("pending") // pending | running | completed | failed | cancelled | skipped

  /// Which mutually-exclusive engine this work needs, so the dispatcher can do
  /// arbitration generically instead of via one method per job type:
  ///   comfy      → ComfyUI must be alive (scene/video/video_post/bgm/anchor/dataset)
  ///   ollama     → ComfyUI must be STOPPED, vision model needs the whole card
  ///   whisper    → ComfyUI must be STOPPED (faster-whisper on GPU)
  ///   kohya      → ComfyUI must be STOPPED (LoRA training)
  ///   standalone → no arbitration (TTS python subprocess)
  engineClass String
  /// Batching key: the WORKFLOW/MODEL identity, not the job type. Two entries
  /// sharing a groupKey can run back-to-back without ComfyUI unloading and
  /// reloading checkpoints (~30 s vs ~2.5 min), which is why the dispatcher
  /// prefers to drain a groupKey before switching. Examples:
  /// "video:video_wan22_i2v_api.json", "video_post", "scene:coffee",
  /// "tts:qwen3", "ollama:vision", "kohya".
  groupKey    String

  /// Queue position. Ascending = dispatched earlier. New work appends at
  /// max+RANK_GAP; reordering rewrites ONLY this column (never queuedAt), and a
  /// drag to an arbitrary slot takes the midpoint between its new neighbours.
  /// Float (not Int) so midpoint insertion practically never needs renumbering,
  /// and (not Decimal) so it crosses the API as a plain JSON number.
  rank Float

  // ── Denormalized snapshot: what this work WAS, still readable after every
  //    upstream row is gone. Captured once at enqueue time.
  projectId     String?
  projectSlug   String?
  projectName   String?
  sceneId       String?
  sceneKey      String?
  shotId        String?
  shotCode      String?
  profileId     String?
  profileCode   String?
  characterCode String?
  segmentId     String?
  blockSlug     String?
  /// Precomputed human label for the queue/history UI ("SH014B ↑FHD⏩FPS").
  label         String

  /// Workflow file actually used, when the job type has one. Snapshot — the
  /// project's comfy/ folder may hold a different version later.
  workflowFilename String?
  comfyPromptId    String?
  /// Basename this attempt produced, if any. Lets a history row still say WHAT
  /// it made after the artifact and its source row are deleted.
  outputFilename   String?
  /// Render parameters at enqueue time (seed/width/height/length/fps, voice,
  /// engine, …). Snapshot, so a deleted render is still reproducible.
  paramsSnapshot   Json?

  /// Cost bucket for the film's time accounting. Null while still in flight.
  ///   useful → this attempt's output is what shipped (or it is necessary
  ///            infrastructure with no competing candidate: QC, dataset, LoRA)
  ///   wasted → everything else that consumed time: failures, cancellations,
  ///            re-renders that lost to a later pick, vision-QC rejections,
  ///            artifacts the user deleted, work orphaned by a container delete
  outcome       String?
  /// WHY it landed in that bucket: chosen | infra | superseded | rejected
  /// | failed | cancelled | deleted | orphaned | unknown.
  /// `unknown` is reserved for rows whose linkage genuinely can't be
  /// reconstructed (see backfilled) — never guessed into useful or wasted.
  outcomeReason String?
  /// When outcome was last (re)computed. Terminal-and-classified rows are not
  /// re-touched; a later edit must not rewrite history that was already true.
  classifiedAt  DateTime?

  queuedAt        DateTime  @default(now())
  /// LEGACY, always null. Held the anti-starvation clock for the head of the
  /// queue back when the dispatcher could let a same-groupKey job cut ahead of
  /// it. Batching moved to enqueue time (nothing overtakes the head any more),
  /// so nothing reads or writes this; kept only to avoid a rewrite of 33k rows
  /// of history for a dropped column.
  firstEligibleAt DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  /// completedAt − startedAt, written once at close. Precomputed so the film's
  /// total time is a SUM over an indexed column instead of 38k+ date deltas.
  durationMs      Int?
  errorMessage    String?

  /// True = reconstructed by scripts/backfill_queue_entries.ts from the job
  /// tables rather than recorded live. Its timings are real (they come from the
  /// source row's startedAt/completedAt); its attemptNumber/groupKey/outcome are
  /// best-effort reconstructions.
  backfilled       Boolean  @default(false)
  /// True where earlier attempts on this source row are known to have existed
  /// but were destroyed before this ledger did (video_post field resets, and the
  /// boot sweep that hard-deleted failed video renders). Honesty flag: waste
  /// totals for such rows are a lower bound, not a fact.
  historyTruncated Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([status, rank])
  @@index([status, engineClass])
  @@index([jobType, jobId])
  @@index([jobType, status])
  @@index([projectId, status])
  @@index([projectId, outcome])
  @@map("queue_entries")
}

/// Visual-style registry. Each row defines a complete style: style-block tokens
/// (prepended to shot prompts), default negative, identity-stack strategy
/// (LoRA face-lock vs IP-Adapter vs IP-Adapter + style-LoRA), LoRA pipeline
/// kind (character training vs none vs style-only), and references to workflow
/// templates used for shots in this style. Project.visualStyle FKs here.
/// See docs/VISUAL_STYLE_ARCHITECTURE.md.
model VisualStyle {
  id                     String   @id
  displayName            String
  styleBlock             String
  defaultNegative        String
  identityStack          String
  loraPipeline           String
  characterIpTemplateKey String?
  environmentTemplateKey String?
  datasetTemplateKey     String?
  loraTrainTemplateKey   String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  @@map("visual_styles")
}

/// Story OBJECTS — a jacket, a car, a sewing machine. A first-class entity
/// alongside characters, NOT a kind of character: props have no age profiles, no
/// LoRA, no dataset, and their anchor is an object study rather than a portrait
/// (user 2026-08-01 «предметы это не люди, они отдельно»).
///
/// The table predates this model — it was created by hand and lived outside the
/// Prisma schema, which is why `props.controller.ts` talks to it through
/// $queryRaw. Declared here 2026-08-01 so the queue ledger can resolve a prop
/// anchor job the same generic way it resolves every other job type. The mapping
/// matches the live DDL exactly; no migration recreates this table.
model Prop {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  projectId   String
  code        String
  name        String
  description String
  /// Path (relative to APP_ROOT) of the installed object anchor, or null while
  /// the prop is text-only. Set either by promoting a render
  /// (POST /props/:id/anchor/from-render) or by generating one
  /// (POST /props/:id/generate-anchor).
  anchorPath  String?
  /// When the USER approved the installed object anchor. Same contract as
  /// CharacterProfile.anchorApprovedAt: PropAnchorService installs the FIRST
  /// rendered candidate automatically, so anchorPath alone proves nothing about
  /// review. NULL = waiting for approval; a re-render clears it.
  anchorApprovedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  anchorJobs PropAnchorJob[]

  @@unique([projectId, code])
  @@map("props")
}

/// Anchor render jobs for PROPS. Deliberately a separate table from
/// `anchor_render_jobs`: that one is keyed by CharacterProfile and carries the
/// portrait/vision-QC lifecycle, none of which applies to an object.
model PropAnchorJob {
  id            String    @id @default(uuid())
  propId        String
  status        String    @default("pending")
  /// Engine this job was queued for: qwen | flux_comic | sdxl_comic. Null means
  /// "resolve from project settings at dispatch". Stored so a queued job renders
  /// on the engine that was picked when it was queued, not on whatever the
  /// project setting says by the time the queue reaches it.
  pipeline      String?
  /// ComfyUI prompt_id once dispatched. Null until pending → running.
  comfyPromptId String?
  /// Directory of the rendered candidates once completed.
  outputPath    String?
  errorMessage  String?
  queuedAt      DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  prop Prop @relation(fields: [propId], references: [id], onDelete: Cascade)

  @@index([propId])
  @@index([status, queuedAt])
  @@map("prop_anchor_jobs")
}
